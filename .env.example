# Copie para .env e preencha. O .env NÃO é versionado.
#
# Onde achar cada valor: Dashboard do Supabase → Project Settings → API.

# URL do projeto, no formato https://<ref>.supabase.co
SUPABASE_URL=

# ⚠️ A chave SECRETA (service_role), não a anônima. Ignora o RLS e dá acesso
# total ao banco: vive só no servidor e nunca chega ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# MinIO — AS FOTOS DOS INSCRITOS.
#
# Bucket PRÓPRIO e privado, e não o `lp-content` onde estão o regulamento e os
# logos: aquele deixa listar o seu índice sem credenciais, e uma key de UUID
# protege contra adivinhar mas não contra listar.
#
# A credencial deve estar acotada A ESTE BUCKET (no console: Access Keys →
# «Restrict beyond user policy»), com s3:PutObject, s3:GetObject, s3:DeleteObject
# sobre `arn:aws:s3:::caocursantes/*` e s3:ListBucket sobre o bucket. Nada mais.
#
# ⚠️ A região é `us-east` e NÃO `us-east-1`. O MinIO a compara literal e devolve
# `AuthorizationHeaderMalformed`, que parece um problema de credencial e não é.
MINIO_ENDPOINT=https://s3.cndr.me
MINIO_REGIAO=us-east
MINIO_BUCKET_FOTOS=caocursantes
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Segredo para GET /api/exportar, o conserto manual da planilha.
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Deixe vazio para desativar o endpoint.
EXPORTACAO_TOKEN=

# A PLANILHA DO JÚRI — o caminho normal.
#
# Depois de cada inscrição o servidor manda a lista inteira ao Web App do
# Apps Script, que reescreve a aba. Instruções em deploy/planilha.gs.
#
# A URL sai de: Apps Script → Implantar → Nova implantação → App da Web,
# com «Executar como: Eu» e «Quem tem acesso: Qualquer pessoa». Termina em /exec.
# O token é o mesmo que se cola no menu «Cãocurso» → «Configurar token…».
# Vazias as duas = não sincroniza nada.
PLANILHA_WEBHOOK_URL=
PLANILHA_WEBHOOK_TOKEN=

# Endereço público do site, só para montar o link da foto que vai à planilha.
# Vazio = usa a origem da requisição, que em local é http://localhost:4321.
# Em produção: https://pet.condor.com.br
SITE_URL=

# MEDIÇÃO DO GOOGLE — o interruptor é esta linha.
#
# Vazia (o padrão) = não se imprime script nenhum: o navegador não pede nada a
# um domínio do Google e nenhuma cookie é escrita. Preencher liga; esvaziar e
# reiniciar o contêiner desliga. Não é preciso rebuild: a variável é lida em
# tempo de execução.
#
# Aceita as duas coisas que o marketing pode mandar, e o site escolhe o trecho
# de instalação pelo prefixo:
#   G-XXXXXXXXXX    etiqueta do Google (GA4) — Admin → Fluxos de dados
#   GTM-XXXXXXX     Tag Manager — no topo do painel do contêiner
# Também valem AW- (Google Ads) e DC- (Campaign Manager).
#
# ⚠️ Ligar isto é uma decisão de LGPD, não só técnica: passa a haver cookie de
# medição e transferência de dados de navegação para o Google. Hoje a página
# NÃO tem aviso de cookies. Ver README, «Medição do Google».
GOOGLE_TAG_ID=
