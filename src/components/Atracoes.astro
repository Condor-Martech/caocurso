---
import { atracoes } from '../data/site';

/**
 * ATRAÇÕES 2026 — Camarim, Caricaturista, Petfotos y Petplace en rejilla 2×2
 * de tarjetas blancas sobre el lavanda de la campaña.
 *
 * Maqueta medida sobre `docs/Desktop - CãoCurso.png` (1366 px), franja
 * y≈4386–5181:
 *   · fondo lavanda #C38ADB (brand-purple), NO el #9E6BC2 hardcodeado antes;
 *   · título en dos líneas fijas, centrado, azul;
 *   · rejilla de 937 px: tarjetas de 455 px de ancho, 28 px de calle, radio 24;
 *   · tarjetas planas: ni borde ni sombra ni hover (no son clicables);
 *   · dentro de cada una, centrado: icono 72 px, título, descripción azul
 *     —no gris— y el icono de Instagram pegado al borde inferior.
 */

/**
 * Los cuatro iconos, dibujados a mano contra la referencia: line-art de trazo
 * redondeado y sin relleno, con el mismo peso en los cuatro —viewBox de 48
 * unidades + `stroke-width="2"`, que a 72 px de render dan los 3 px medidos en
 * el mockup—. Los SVG genéricos anteriores (una persona, una carita, una casa)
 * no se parecían a nada de la referencia.
 *
 * Van como cadenas y no como cuatro <svg> repetidos para no duplicar cuatro
 * veces los atributos del contenedor. El HTML es literal de este archivo, no
 * entra nada del exterior, así que `set:html` es seguro aquí.
 *
 * Empieza la cabeza de perro de perfil mirando a la IZQUIERDA: contorno
 * (coronilla, hocico y mandíbula), ceja y oreja caída, en x 2,2–36,4 ·
 * y 3,5–32. En la referencia es el mismo dibujo el que aparece en Camarim y
 * —espejado— dentro del corazón de Caricaturista, así que aquí se define una
 * sola vez.
 */
const cabecaCao = `
  <path d="M36.4 19.4c0-9.1-5.6-15.9-13.4-15.9-2.4 0-4 .8-4.9 2.3-.7 1.2-1 2.8-1.6 4-.5 1-1.3 1.6-2.4 1.8l-9.9 1.6c-1.4.2-2.1.9-2 2.1.1 1.3.6 2.9 1.4 4.6 1.4 3.1 3.6 4.7 6.5 4.7h9.7"/>
  <path d="M15.6 15.2c.4-1.2 1.1-1.8 2-1.8s1.6.6 2 1.8"/>
  <path d="M24.7 10.3c-.2 4.4-1.9 8.7-5 12.9-1.6 2.2-2 4.3-1.1 6.1.9 1.8 2.8 2.7 5.6 2.7"/>
`;

const desenhosIcone: Record<string, string | undefined> = {
  /* Cabeza de perro + tijeras abiertas (dos hojas cruzadas, dos anillas y el
     apoyo del pulgar). */
  camarim: `
    ${cabecaCao}
    <path d="M29.1 17.5 39 35.4"/>
    <path d="M43.4 17.5 33.5 35.4"/>
    <ellipse cx="31.7" cy="39.6" rx="2.7" ry="4.2" transform="rotate(-10 31.7 39.6)"/>
    <ellipse cx="40.8" cy="39.6" rx="2.7" ry="4.2" transform="rotate(10 40.8 39.6)"/>
    <path d="M24.4 44.8c2.7.2 4.5-1.4 4.8-4.2"/>
  `,

  /* La misma cabeza, espejada (mira a la derecha) y reducida al 72 %, dentro de
     un corazón. El grupo lleva stroke-width 2,78 para que 2,78 × 0,72 = 2 y el
     trazo salga idéntico al del corazón; si no, la cabeza se vería más fina. */
  caricaturista: `
    <path d="M24 43.9C12.9 35.5 2.4 26.6 2.4 16.5 2.4 9.3 7.7 3.4 14.3 3.4c4 0 7.6 2.1 9.7 5.4 2.1-3.3 5.7-5.4 9.7-5.4 6.6 0 11.9 5.9 11.9 13.1 0 10.1-10.5 19-21.6 27.4Z"/>
    <g transform="translate(37.7 10.5) scale(-0.72 0.72)" stroke-width="2.78">${cabecaCao}</g>
  `,

  /* Cara de perro de frente dentro de un marco de foto de doble filete. */
  petfotos: `
    <rect x="2.5" y="1.2" width="43" height="45.6" rx="1.5"/>
    <rect x="7.3" y="6" width="33.4" height="30.3" rx="1"/>
    <ellipse cx="24" cy="20.5" rx="8" ry="9.5"/>
    <path d="M17.5 13.2c-3.6.5-6 3-6.6 6.8-.6 4 .5 8 3 10.7 1.2 1.3 2.6 2 3.8 1.9"/>
    <path d="M30.5 13.2c3.6.5 6 3 6.6 6.8.6 4-.5 8-3 10.7-1.2 1.3-2.6 2-3.8 1.9"/>
    <circle cx="20.6" cy="18.6" r="1.3" fill="currentColor" stroke="none"/>
    <circle cx="27.4" cy="18.6" r="1.3" fill="currentColor" stroke="none"/>
    <path d="M24 22.6c1.6 0 2.9 1.1 2.9 2.4 0 1.4-1.3 2.5-2.9 2.5s-2.9-1.1-2.9-2.5c0-1.3 1.3-2.4 2.9-2.4Z"/>
    <path d="M24 27.5v1.4"/>
    <path d="M24 28.9c-.8.9-1.8 1.4-2.9 1.4"/>
    <path d="M24 28.9c.8.9 1.8 1.4 2.9 1.4"/>
  `,

  /* Huella (almohadilla + tres dedos) dentro de un pin de ubicación. */
  petplace: `
    <path d="M41.7 19.2c0 11.3-17.7 27.2-17.7 27.2S6.3 30.5 6.3 19.2C6.3 9.5 14.2 1.6 24 1.6s17.7 7.9 17.7 17.6Z"/>
    <circle cx="24" cy="19.2" r="12.4"/>
    <circle cx="23.7" cy="13.7" r="2.3"/>
    <circle cx="16.8" cy="17.1" r="2.3"/>
    <circle cx="30.9" cy="17.1" r="2.3"/>
    <path d="M24 18.9c-1.5 0-2.5 1-3.5 2.1-.9 1-2.4 1.9-2.4 3.4 0 1.3 1.1 2.3 2.6 2.3.9 0 1.8-.3 2.5-.5.5-.2 1.1-.2 1.6 0 .7.2 1.6.5 2.5.5 1.5 0 2.6-1 2.6-2.3 0-1.5-1.5-2.4-2.4-3.4-1-1.1-2-2.1-3.5-2.1Z"/>
  `,
};
---

<section class="bg-brand-purple pt-16 pb-8 lg:pt-20">
  <div class="container-lp">
    <!-- Dos líneas fijas: así se rompe en la referencia y así cabe a 360 px -->
    <h2
      class="mb-20 text-center text-[1.625rem] leading-tight font-black text-brand-blue sm:text-4xl lg:mb-28 lg:text-[3.125rem]"
    >
      <span class="block">Confira as outras</span>
      <span class="block">atrações disponíveis:</span>
    </h2>

    {/* auto-rows-fr iguala la altura de las dos filas: en el mockup las cuatro
        tarjetas miden lo mismo aunque dos descripciones ocupen dos líneas. */}
    <div class="mx-auto grid max-w-235 auto-rows-fr grid-cols-1 gap-7 sm:grid-cols-2">
      {
        atracoes.map((a) => (
          <div class="flex flex-col items-center rounded-3xl bg-brand-white px-6 pt-7 pb-5 text-center">
            <svg
              class="h-16 w-16 text-brand-blue sm:h-18 sm:w-18"
              viewBox="0 0 48 48"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              focusable="false"
            >
              <Fragment set:html={desenhosIcone[a.icone] ?? ''} />
            </svg>

            <h3 class="mt-4 text-2xl leading-tight font-bold text-brand-blue">{a.titulo}</h3>

            {/* max-w + text-balance reproducen el corte en dos líneas del mockup
                («Que tal uma foto / impressa com seu pet?») sin meter <br> en los
                datos, y dejan en una sola línea las descripciones que caben. */}
            <p class="mt-3 max-w-60 text-[0.9375rem] leading-snug text-balance text-brand-blue">
              {a.descricao}
            </p>

            {/* Las atrações no tienen todavía perfil de Instagram conocido: el
                icono va decorativo, sin <a>, para no dejar un enlace roto.
                Cuando lleguen las URLs, envolver en <a href> con aria-label. */}
            <span class="mt-auto pt-4 text-brand-blue" aria-hidden="true">
              <svg
                class="h-9 w-9 sm:h-10.5 sm:w-10.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                focusable="false"
              >
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4.3" />
                <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
              </svg>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
