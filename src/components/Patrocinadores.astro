---
import { patrocinio, apoio } from '../data/site';

/**
 * PATROCÍNIO / APOIO — una sola barra blanca redondeada a lo ancho.
 * Los logos van en una grilla de 8 columnas (patrocínio arriba, apoio abajo)
 * para mostrarse a buen tamaño y alineados entre sí.
 * Esta sección faltaba en la documentación previa.
 */

const grupos = [
  { titulo: 'Patrocínio:', marcas: patrocinio, colsMobile: 'grid-cols-4' },
  { titulo: 'Apoio:', marcas: apoio, colsMobile: 'grid-cols-3' },
];
---

<section class="bg-[var(--c-orange)] pb-12 md:pb-16">
  <div class="container-lp">
    <div
      class="grid items-center gap-x-8 gap-y-6 rounded-3xl bg-white px-6 py-8 md:grid-cols-[auto_1fr] md:gap-y-8 md:px-10 md:py-10"
    >
      {
        grupos.map((grupo, i) => (
          <>
            {i > 0 && <hr class="border-t border-[var(--c-gray)]/30 md:col-span-2" />}
            <h2 class="text-center text-lg font-bold text-[var(--c-blue)] italic md:text-left md:text-xl">
              {grupo.titulo}
            </h2>
            <ul
              class:list={[
                'grid items-center gap-x-4 gap-y-6 md:grid-cols-8 md:gap-x-5',
                grupo.colsMobile,
              ]}
            >
              {grupo.marcas.map((p) => (
                <li class="flex h-16 items-center justify-center md:h-20">
                  <img
                    src={p.logo}
                    alt={p.nome}
                    class="max-h-full max-w-full object-contain"
                    loading="lazy"
                  />
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </div>
  </div>
</section>
