---
import { gruposMarcas, type Marca } from '../data/site';

/**
 * PATROCÍNIO / APOIO 2026
 *
 * Referencia: docs/Desktop - CãoCurso.png, y=7377..7633 (recorte ref_7.png).
 * Dos tarjetas blancas MUY redondeadas (r≈26 px sobre una caja de 105 px de
 * alto a 1366 px), separadas por aire, sobre el fondo lavanda. Sin sombra:
 * en el mockup el borde es limpio.
 *
 * Cada tarjeta = etiqueta a la izquierda + fila de logos a la derecha.
 * La etiqueta va CENTRADA en su columna: medido en el mockup, «Patrocínio:»
 * ocupa x=245..359 (centro 302) y «Apoio:» x=261..335 (centro 298). No están
 * alineadas a la izquierda, comparten centro. De ahí el ancho fijo de columna
 * con `text-center` en ≥md.
 *
 * ── Cómo se dimensiona cada logo ─────────────────────────────────────────────
 *
 * Un logo NO se puede normalizar por alto ni por ancho: se normaliza por PESO
 * ÓPTICO. Es el error que había antes —una caja de alto común más un
 * `larguraMax` a ojo por marca— y se veía: el lockup de Nestlé Purina (9,38:1)
 * topaba por ancho y acababa en una tira de 17 px de alto al lado del sello
 * cuadrado de Friskies, de 80. Medido en la página, entre el logo más presente y
 * el menos había 2,7× de diferencia de área.
 *
 * Aquí el tamaño sale de la proporción real del archivo (`largura`/`altura` en
 * site.json):
 *
 *   alto = ALTO_BASE / proporción^EXPONENTE
 *
 * `EXPONENTE` es el mando:
 *   0    → todos al mismo ALTO   (los alargados dominan la fila)
 *   0,5  → todos a la misma ÁREA (los alargados se vuelven larguísimos)
 *   0,42 → el punto intermedio que usamos: un lockup 2,28:1 baja a 68 px de alto
 *          y sube a 155 de ancho, y pesa parecido a un sello de 92×92.
 *
 * `ANCHO_MAX` es la red de seguridad para proporciones extremas. Nestlé Purina
 * la toca: con 9,38:1 no hay tamaño que lo iguale sin que ocupe media fila.
 * Eso no se arregla con CSS — hace falta la versión cuadrada del logo, que
 * existe en assets-fonte (600×600) pero no es la que se está sirviendo.
 *
 * Marcas sin logo oficial: se pinta el NOMBRE en brand-blue en una caja de peso
 * comparable, para que no parezca un hueco olvidado. Nunca el logo de otra
 * empresa — ver los TODO de site.ts.
 */

interface Grupo {
  titulo: string;
  marcas: Marca[];
}

/* Los dos grupos y su rótulo salen de site.json, como el resto del contenido. */
const grupos: Grupo[] = gruposMarcas;

const ALTO_BASE = 92;
const EXPONENTE = 0.42;
const ANCHO_MAX = 190;

/* Caja de las marcas que todavía no tienen archivo: se le da un peso parecido
   al de un logo real para que la fila no se descuadre donde falta uno. */
const CAJA_TEXTO = { w: 132, h: 60 };

function caixa(m: Marca) {
  if (!m.largura || !m.altura) return CAJA_TEXTO;
  const proporcao = m.largura / m.altura;
  let h = ALTO_BASE / Math.pow(proporcao, EXPONENTE);
  let w = h * proporcao;
  if (w > ANCHO_MAX) {
    w = ANCHO_MAX;
    h = w / proporcao;
  }
  return { w: Math.round(w), h: Math.round(h) };
}
---

{/* pt corto: la Galeria (misma franja lavanda) ya aporta su propio pb.
    pb largo: en el mockup hay ~140 px de lavanda entre la 2ª tarjeta y el footer. */}
<section id="patrocinio" class="bg-brand-purple pt-6 pb-24 md:pt-8 md:pb-36">
  <div class="container-lp flex flex-col gap-8 md:gap-11">
    {
      grupos.map((grupo) => (
        <div class="flex flex-col items-center gap-6 rounded-[1.75rem] bg-brand-white px-6 py-7 md:flex-row md:gap-4 md:rounded-4xl md:px-8 md:py-8">
          <h2 class="text-brand-blue text-center text-xl font-bold italic md:w-40 md:shrink-0 md:text-2xl">
            {grupo.titulo}
          </h2>

          {/* Huecos iguales y fila centrada, no `justify-between`: repartir el
              sobrante entre logos de anchos distintos los separa de forma
              desigual y es justo lo que hace que una fila se lea descuidada. */}
          <ul class="marcas">
            {grupo.marcas.map((marca) => {
              const { w, h } = caixa(marca);
              return (
                <li class="marca" style={`--w:${w}px;--h:${h}px`}>
                  {marca.logo ? (
                    <img
                      src={marca.logo}
                      alt={marca.nome}
                      width={marca.largura}
                      height={marca.altura}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    /* TODO: falta el logo oficial de esta marca (ver site.ts).
                       Hueco honesto en texto hasta que llegue el archivo. */
                    <span class="marca__texto">{marca.nome}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* La fila. `--esc` escala TODOS los logos a la vez conservando la relación
     entre ellos: el trabajo de igualar el peso óptico se hace una sola vez, en
     el cálculo de la caja, y aquí sólo se cambia de talla. */
  .marcas {
    --esc: 0.68;
    display: flex;
    width: 100%;
    flex: 1;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.5rem 2rem;
  }

  @media (min-width: 640px) {
    .marcas {
      --esc: 0.82;
      gap: 1.75rem 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .marcas {
      --esc: 1;
      gap: 2rem 2.75rem;
    }
  }

  .marca {
    display: flex;
    height: calc(var(--h) * var(--esc));
    width: calc(var(--w) * var(--esc));
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
  }

  .marca img {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* El nombre tiene que pesar como un logo, no como un pie de foto. A 17 px
     dentro de una caja de 60 parecía un hueco olvidado al lado de un sello de
     92×92; se sube y se deja partir en dos líneas, que es como se comporta un
     lockup de dos palabras. */
  .marca__texto {
    color: var(--c-blue);
    font-weight: 800;
    font-size: clamp(1.0625rem, 1.7vw, 1.5rem);
    line-height: 1.1;
    text-align: center;
    text-wrap: balance;
  }
</style>
