  @keyframes selo-entra {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sucesso__fechar {
      transition: none;
    }
  }

  /* ------------------------------------------------------------ enviar */

  .btn-enviar {
    width: 100%;
    border-radius: 9999px;
    background-color: var(--c-blue);
    color: var(--c-white);
    font-family: inherit;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    padding: 0.875rem 2.5rem;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      opacity 0.15s ease;
  }

  .btn-enviar:hover {
    background-color: var(--c-blue-deep);
  }

  .btn-enviar:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  @media (min-width: 768px) {
    .campo,
    .arquivo__pill {
      font-size: 1.125rem;
    }

    .campo--area {
      height: clamp(4.5rem, 10svh, 8rem);
    }

    .aceite__texto {
      font-size: 0.875rem;
    }

    .arquivo {
      width: auto;
    }

    .arquivo__pill {
      width: auto;
      justify-content: flex-start;
    }

    .btn-enviar {
      width: auto;
      font-size: 1.75rem;
      padding: 0.875rem 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .campo,
    .arquivo__pill,
    .btn-enviar {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Envío sin salir de la página.
   *
   * Sin este script el <form> hace un POST nativo y el usuario termina mirando
   * el JSON crudo de la API en una pestaña en blanco. Con él: fetch multipart,
   * botón bloqueado mientras va, respuesta pintada en la tarjeta y el campo que
   * la API señala (`campo`) marcado en rojo. Si el JS no carga, el POST nativo
   * sigue existiendo: nada de esto es un requisito para poder inscribirse.
   *
   * Por qué la fecha es type="text" y no type="date":
   *   1. type="date" no admite placeholder — siempre enseña «dd/aaaa/mm» del
   *      navegador y rompe la composición de la referencia, que muestra
   *      «Data de nascimento» en gris como todos los demás campos.
   *   2. Es una fecha de NACIMIENTO: el selector nativo abre en el mes actual y
   *      obliga a retroceder décadas. Teclear 8 dígitos con el teclado numérico
   *      es más rápido en móvil, y el `inputmode="numeric"` ya lo levanta.
   *   3. El widget nativo es inconsistente entre navegadores (rueda en iOS,
   *      tres cajitas en Firefox), así que ni siquiera se gana coherencia.
   * A cambio se añade una máscara dd/mm/aaaa y el `pattern` protege también el
   * camino sin JS. El servidor acepta las dos formas, dd/mm/aaaa y aaaa-mm-dd,
   * por si algún día se cambia de idea.
   */

  /* Techo del servidor. Ya no es una restricción real de uso: `reduzirImagem`
     encoge la foto antes de subirla, así que lo habitual es enviar ~300 KB
     venga el original de donde venga. Queda como tope contra abusos y para el
     camino sin JavaScript, donde sí sube el fichero original.

     Eran 2 MB, y eso rechazaba a casi todo el mundo: prácticamente ningún
     móvil actual hace fotos de menos de 2 MB. */
  const MAX_FOTO_BYTES = 25 * 1024 * 1024;

  /* El mismo lado máximo que aplica el servidor. Reducir más aquí sería tirar
     calidad que allí ya no se recupera. */
  const LADO_MAXIMO = 1600;

  /**
   * Reduce la foto en el navegador antes de subirla.
   *
   * Es la mejora que de verdad se nota: una foto de móvil son 3-8 MB —hasta 40
   * en un Samsung de 200MP— y por datos móviles eso es un minuto largo de
   * espera con el formulario bloqueado. Reducida son ~300 KB y un par de
   * segundos.
   *
   * Devuelve `null` si no se puede: formato que el navegador no decodifica,
   * canvas no disponible, o un resultado que no es más pequeño que el original.
   * En ese caso se sube el fichero tal cual y el servidor lo reprocesa igual.
   * **Esto nunca debe impedir un envío**: es una optimización, no una
   * validación.
   *
   * `imageOrientation: 'from-image'` aplica la orientación del EXIF al dibujar.
   * Sin eso las fotos verticales llegan tumbadas, porque el canvas descarta los
   * metadatos y con ellos la rotación.
   *
   * Que el canvas se lleve por delante el EXIF es un efecto agradable —ahí van
   * las coordenadas GPS de la casa del tutor— pero no es la defensa: el cliente
   * se puede saltar. Quien lo garantiza es `lib/foto.ts`, en el servidor.
   */
  async function reduzirImagem(arquivo: File): Promise<File | null> {
    if (!arquivo.type.startsWith('image/')) return null;
    if (typeof createImageBitmap !== 'function') return null;

    try {
      const bitmap = await createImageBitmap(arquivo, { imageOrientation: 'from-image' });
      const escala = Math.min(1, LADO_MAXIMO / Math.max(bitmap.width, bitmap.height));
      const largura = Math.round(bitmap.width * escala);
      const altura = Math.round(bitmap.height * escala);

      const canvas = document.createElement('canvas');
      canvas.width = largura;
      canvas.height = altura;

      const ctx = canvas.getContext('2d');
      if (!ctx) {
        bitmap.close();
        return null;
      }
      ctx.drawImage(bitmap, 0, 0, largura, altura);
      bitmap.close();

      const blob = await new Promise<Blob | null>((resolver) =>
        canvas.toBlob(resolver, 'image/webp', 0.85)
      );
      if (!blob || blob.size >= arquivo.size) return null;

      return new File([blob], 'pet.webp', { type: 'image/webp' });
    } catch {
      return null;
    }
  }

  /* Dos cosas que el envío y el modal tienen que compartir.
   *
   * `enviando` vive aquí, y no dentro de `iniciar()`, porque también manda sobre
   * el cierre: mientras una inscripción está en vuelo no se puede cerrar el
   * modal. Cerrarlo no cancelaría nada —la petición ya salió— pero dejaría a la
   * persona sin saber si su pet quedó inscrito, y lo más probable es que
   * volviera a enviarlo todo otra vez.
   *
   * `fecharModal` es la única forma que tiene el envío de cerrar. Se queda en
   * `null` cuando no hay modal —sin JavaScript el formulario es una sección
   * normal— y entonces no se cierra nada, que es lo correcto. */
  let enviando = false;
  let fecharModal: (() => void) | null = null;

  /* Devolver la tarjeta al estado inicial después de una inscripción: quitar la
     pantalla de éxito, desbloquear los campos y recuperar el botón. Vive aquí
     porque quien la dispara es el CIERRE —el aspa, Escape, el botón «Fechar» o
     el temporizador—, y el cierre lo gestiona el modal, no el envío. */
  let restaurarFormulario: (() => void) | null = null;

  const form = document.querySelector<HTMLFormElement>('#form-inscricao');
  if (form) iniciar(form);

  iniciarModal();

  /**
   * Abrir y cerrar el formulario como modal.
   *
   * El HTML no declara `role="dialog"` ni `aria-modal`: se ponen al abrir y se
   * quitan al cerrar. Mientras el bloque está oculto o funcionando como sección
   * normal no hay ningún diálogo, y anunciarlo como tal sería describir algo
   * que no existe.
   */
  function iniciarModal() {
    const modal = document.querySelector<HTMLElement>('[data-modal]');
    if (!modal) return;

    const caixa = modal.querySelector<HTMLElement>('.modal__caixa');
    if (!caixa) return;

    /* Quién tenía el foco antes de abrir, para devolvérselo al cerrar. Sin
       esto, cerrar el modal manda el foco al <body> y quien navega con teclado
       vuelve a empezar desde el principio de la página. */
    let focoPrevio: HTMLElement | null = null;

    const FOCABLES =
      'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

    /* ------------------------------------------------- alto de la hoja móvil

       Debajo de 768 px el modal es una hoja a pantalla completa con la cabecera
       y el pie fijos (ver el CSS). Para eso hace falta saber cuánta pantalla
       hay DE VERDAD, y `100svh` no lo sabe: al abrir el teclado, iOS encoge el
       viewport visual y deja el de layout intacto, así que una capa `fixed` de
       100svh se queda con el pie por debajo de las teclas — y en algunas
       versiones se va entera fuera de pantalla.

       `visualViewport` sí lo sabe. `offsetTop` importa tanto como `height`:
       cuando iOS desplaza el viewport visual para enseñar el campo enfocado, la
       hoja tiene que seguirlo o se queda flotando por encima del recorte.

       Sin soporte —o con el modal cerrado— no se publica nada y el CSS se cae a
       `100svh`, que es exactamente lo que había antes. */
    const vv = window.visualViewport;

    /* Debajo de esto, la hoja va apretada: es lo que queda al abrir el teclado
       en un móvil normal (~360 px de los 659 que había). */
    const FOLHA_BAIXA = 460;

    function medirFolha() {
      if (!vv) return;
      modal!.style.setProperty('--folha-h', `${Math.round(vv.height)}px`);
      modal!.style.setProperty('--folha-topo', `${Math.round(vv.offsetTop)}px`);

      /* Una clase y no una media query de `max-height`: esas se miden contra el
         viewport de LAYOUT, que con el teclado abierto sigue valiendo 659 px en
         iOS y por tanto nunca se dispararían. El único que sabe cuánta pantalla
         queda de verdad es este listener. */
      modal!.classList.toggle('folha-baixa', vv.height < FOLHA_BAIXA);
    }

    function soltarFolha() {
      modal!.style.removeProperty('--folha-h');
      modal!.style.removeProperty('--folha-topo');
      modal!.classList.remove('folha-baixa');
    }

    function abrir() {
      if (modal!.classList.contains('aberto')) return;

      focoPrevio = document.activeElement as HTMLElement | null;

      modal!.classList.add('aberto');
      modal!.setAttribute('role', 'dialog');
      modal!.setAttribute('aria-modal', 'true');
      modal!.setAttribute('aria-labelledby', 'modal-inscricao-titulo');

      /* Bloquear el scroll del fondo compensando el ancho de la barra: sin la
         compensación, al desaparecer la barra la página entera se desplaza unos
         píxeles y todo pega un salto lateral al abrir el modal. */
      const barra = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = 'hidden';
      if (barra > 0) document.body.style.paddingRight = `${barra}px`;

      document.addEventListener('keydown', aoTeclado);

      medirFolha();
      if (vv) {
        vv.addEventListener('resize', medirFolha);
        vv.addEventListener('scroll', medirFolha);
      }

      /* Al primer campo, no al botón de cerrar: quien abre el formulario quiere
         escribir. `preventScroll` evita que el navegador salte por su cuenta
         antes de que el modal termine de colocarse. */
      const primeiro = modal!.querySelector<HTMLElement>('#tutorNome');
      (primeiro ?? caixa!).focus({ preventScroll: true });
    }

    function fechar() {
      if (!modal!.classList.contains('aberto')) return;

      /* Mientras la inscripción está en vuelo, no se cierra: ni con Escape, ni
         con la X, ni tocando el velo. La petición ya salió y cerrar no la
         cancela; lo único que consigue es que la persona no vea si quedó
         inscrita, y que lo intente otra vez. El estado «Enviando…» sigue a la
         vista, que es la respuesta a por qué no se cierra. */
      if (enviando) return;

      modal!.classList.remove('aberto');
      modal!.removeAttribute('role');
      modal!.removeAttribute('aria-modal');
      modal!.removeAttribute('aria-labelledby');

      document.body.style.overflow = '';
      document.body.style.paddingRight = '';

      document.removeEventListener('keydown', aoTeclado);
      if (vv) {
        vv.removeEventListener('resize', medirFolha);
        vv.removeEventListener('scroll', medirFolha);
      }
      soltarFolha();

      /* Si se cerró con una inscripción ya hecha, la tarjeta vuelve a ser el
         formulario. Se hace AL CERRAR y no sólo en el temporizador: quien pulse
         «Fechar» a los dos segundos no puede reabrir y encontrarse todavía la
         pantalla de «Inscrição realizada». */
      restaurarFormulario?.();

      /* Devolver el foco a quien lo tenía. Si no lo tenía nadie —el caso real es
         llegar por un enlace con la ancla puesta, donde el modal abre solo al
         cargar— `document.activeElement` era el <body>, y enfocar el <body> deja
         el foco en la nada: quien navega con teclado tendría que tabular la
         página entera otra vez. En ese caso se cae al disparador, que es donde
         habría estado si hubiera llegado por su propio pie. */
      const destino =
        focoPrevio && focoPrevio !== document.body
          ? focoPrevio
          : document.querySelector<HTMLElement>('[data-abrir-inscricao]');
      destino?.focus();
      focoPrevio = null;
    }

    function aoTeclado(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        fechar();
        return;
      }

      if (e.key !== 'Tab') return;

      /* Trampa de foco. Sin esto el tabulador se escapa al contenido de detrás
         —que está oculto pero sigue siendo focalizable— y el usuario se queda
         tecleando en una página que no ve. */
      const focables = Array.from(modal!.querySelectorAll<HTMLElement>(FOCABLES)).filter(
        (el) => el.offsetParent !== null || el === document.activeElement
      );
      if (!focables.length) return;

      const primeiro = focables[0]!;
      const ultimo = focables[focables.length - 1]!;

      if (e.shiftKey && document.activeElement === primeiro) {
        e.preventDefault();
        ultimo.focus();
      } else if (!e.shiftKey && document.activeElement === ultimo) {
        e.preventDefault();
        primeiro.focus();
      }
    }

    /* El disparador es un <a href="#modal-inscricao">, así que sin JS ya
       funciona como ancla. Aquí se intercepta para abrirlo como modal. */
    document.querySelectorAll<HTMLElement>('[data-abrir-inscricao]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        abrir();
      });
    });

    modal.querySelectorAll<HTMLElement>('[data-fechar]').forEach((el) => {
      el.addEventListener('click', fechar);
    });

    /* Un enlace compartido con la ancla puesta abre el formulario directamente,
       en vez de dejar al visitante mirando una página donde no pasa nada. */
    if (window.location.hash === '#modal-inscricao') abrir();

    fecharModal = fechar;
  }

  function iniciar(form: HTMLFormElement) {
    const botao = form.querySelector<HTMLButtonElement>('[data-enviar]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const inputFoto = form.querySelector<HTMLInputElement>('#petFoto');
    const nomeArquivo = form.querySelector<HTMLElement>('[data-arquivo]');
    const rotuloBotao = botao ? botao.textContent : '';

    const modalEl = document.querySelector<HTMLElement>('[data-modal]');
    const topo = document.querySelector<HTMLElement>('[data-topo]');
    const sucesso = document.querySelector<HTMLElement>('[data-sucesso]');
    const sucessoDetalhe = document.querySelector<HTMLElement>('[data-sucesso-detalhe]');

    /* Cuánto se deja la pantalla de «Inscrição realizada» antes de cerrar sola.
       Eran 3 s cuando esto era una línea de texto en una barra azul; con el
       nombre del pet y un mensaje de dos líneas, tres segundos no dan para
       leerlo. Y ahora hay un botón «Fechar» a la vista, así que quien no quiera
       esperar no depende de encontrar el aspa de la esquina. */
    const ESPERA_ANTES_DE_FECHAR = 6000;

    let temporizador = 0;

    /* Los campos se bloquean mientras se envía. Un `disabled` NO viaja en el
       FormData, así que se pone DESPUÉS de construirlo — al revés se enviaría
       una ficha vacía. */
    const campos = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        'input, select, textarea'
      )
    );
    const bloquearCampos = (bloquear: boolean) => {
      for (const campo of campos) campo.disabled = bloquear;
    };

    /* ---------------------------------------------------------- máscaras */

    const mascarar = (id: string, formatar: (digitos: string) => string) => {
      const el = form.querySelector<HTMLInputElement>(`#${id}`);
      if (!el) return;
      el.addEventListener('input', () => {
        const noFim = el.selectionStart === el.value.length;
        el.value = formatar(el.value.replace(/\D/g, ''));
        // Sólo se reposiciona el cursor si ya estaba al final; si el usuario
        // está corrigiendo en medio, se le deja donde estaba.
        if (noFim) el.setSelectionRange(el.value.length, el.value.length);
        limpar(el);
      });
    };

    // dd/mm/aaaa — nunca deja una barra colgando, así el borrado no se atasca.
    mascarar('tutorNascimento', (d) => {
      d = d.slice(0, 8);
      let saida = d.slice(0, 2);
      if (d.length > 2) saida += `/${d.slice(2, 4)}`;
      if (d.length > 4) saida += `/${d.slice(4)}`;
      return saida;
    });

    // 000.000.000-00
    mascarar('tutorCpf', (d) => {
      d = d.slice(0, 11);
      let saida = d.slice(0, 3);
      if (d.length > 3) saida += `.${d.slice(3, 6)}`;
      if (d.length > 6) saida += `.${d.slice(6, 9)}`;
      if (d.length > 9) saida += `-${d.slice(9)}`;
      return saida;
    });

    // (41) 3333-4444 · (41) 99999-8888
    mascarar('tutorTelefone', (d) => {
      d = d.slice(0, 11);
      if (!d) return '';
      const celular = d.length > 10;
      let saida = `(${d.slice(0, 2)}`;
      if (d.length > 2) saida += `) ${celular ? d.slice(2, 7) : d.slice(2, 6)}`;
      if (d.length > 6) saida += `-${celular ? d.slice(7) : d.slice(6)}`;
      return saida;
    });

    /* ------------------------------------------------------ marcas de erro */

    function limpar(el: Element) {
      el.removeAttribute('aria-invalid');
    }

    function limparTudo() {
      form.querySelectorAll('[aria-invalid]').forEach(limpar);
    }

    function marcar(campo: string) {
      const alvo = form.querySelector<HTMLElement>(`#${campo}`);
      if (!alvo) return;
      alvo.setAttribute('aria-invalid', 'true');
      alvo.focus();
    }

    // Al reescribir un campo señalado, se le quita la marca roja.
    form.querySelectorAll('input, textarea').forEach((el) => {
      el.addEventListener('input', () => limpar(el));
    });

    /* --------------------------------------------------- nome do arquivo */

    if (inputFoto) {
      inputFoto.addEventListener('change', () => {
        const arquivo = inputFoto.files && inputFoto.files[0];
        if (nomeArquivo) {
          nomeArquivo.textContent = arquivo ? arquivo.name : '';
          nomeArquivo.hidden = !arquivo;
        }
        /* Ya no se comprueba el tamaño aquí. Lo que cuenta es cuánto pesa
           DESPUÉS de reducir, y eso no se sabe hasta el envío. Avisar ahora de
           un original de 8 MB que va a viajar como 300 KB sería asustar sin
           motivo, y es justo lo que hacía el aviso de 2 MB. */
      });
    }

    /* ----------------------------------------------------------- estado */

    function mostrar(texto: string, estado: 'enviando' | 'ok' | 'erro') {
      if (!status) return;
      status.textContent = texto;
      status.dataset.estado = estado;
      status.hidden = false;
    }

    /* ------------------------------------------------- inscrição concluída */

    /**
     * Cambia el formulario por la pantalla de «Inscrição realizada».
     *
     * El nombre del pet viene del servidor —`dados.petNome`, la ficha tal como
     * quedó guardada— y se escribe con `textContent`. **Nunca con `innerHTML`**:
     * es texto que teclea el usuario, admite 60 caracteres y vuelve del
     * servidor tal cual.
     */
    function mostrarSucesso(petNome: string) {
      if (!sucesso) {
        /* No debería ocurrir, pero si el panel no está se cae a la barra de
           antes: la confirmación no puede depender de un nodo. */
        mostrar('Inscrição enviada com sucesso!', 'ok');
        return;
      }

      if (sucessoDetalhe) {
        const modelo = sucessoDetalhe.dataset.modelo ?? '';
        sucessoDetalhe.textContent = petNome
          ? modelo.replace('{pet}', petNome)
          : (sucessoDetalhe.dataset.semNome ?? '');
      }

      form.hidden = true;
      if (topo) topo.hidden = true;
      sucesso.hidden = false;
      modalEl?.classList.add('concluido');

      /* El foco tiene que irse del formulario: lo acabamos de ocultar, y quien
         navegue con teclado o lector de pantalla se quedaría con el foco en un
         campo que ya no existe. La trampa de foco filtra por `offsetParent`, así
         que a partir de aquí sólo queda el botón «Fechar». */
      sucesso.focus({ preventScroll: true });
    }

    /**
     * Vuelve al formulario. La llama el CIERRE, no el envío — ver
     * `restaurarFormulario` arriba.
     */
    function restaurar() {
      if (temporizador) {
        window.clearTimeout(temporizador);
        temporizador = 0;
      }

      if (sucesso && !sucesso.hidden) {
        sucesso.hidden = true;
        form.hidden = false;
        if (topo) topo.hidden = false;
        modalEl?.classList.remove('concluido');
      }

      bloquearCampos(false);
      if (botao) {
        botao.disabled = false;
        botao.textContent = rotuloBotao;
      }
      if (status) status.hidden = true;
    }

    restaurarFormulario = restaurar;

    /* ----------------------------------------------------------- envio */

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (enviando) return;

      const arquivo = inputFoto && inputFoto.files && inputFoto.files[0];

      enviando = true;
      limparTudo();
      if (botao) {
        botao.disabled = true;
        botao.textContent = 'Enviando…';
      }

      /* Todo lo que sigue va dentro del try para que el `finally` devuelva el
         botón a su sitio, incluidos los `return` por foto rechazada. */
      try {
        /* El FormData PRIMERO y el bloqueo después: un campo `disabled` no
           viaja en el envío, así que hacerlo al revés mandaría la ficha vacía. */
        const envio = new FormData(form);
        bloquearCampos(true);

        if (arquivo) {
          mostrar('Preparando a foto…', 'enviando');
          const reduzida = await reduzirImagem(arquivo);
          if (reduzida) envio.set('petFoto', reduzida, reduzida.name);

          /* Se comprueba lo que se va a enviar de verdad, no el original: si la
             reducción funcionó, un original de 40 MB pasa sin problema. */
          if ((reduzida ?? arquivo).size > MAX_FOTO_BYTES) {
            /* Desbloquear ANTES de marcar: `marcar()` enfoca el campo, y un
               campo `disabled` no acepta el foco. El `finally` lo haría igual,
               pero después — y para entonces el foco ya se habría perdido. */
            bloquearCampos(false);
            marcar('petFoto');
            mostrar('A foto é grande demais. Escolha outra imagem.', 'erro');
            return;
          }
        }

        mostrar('Enviando sua inscrição…', 'enviando');

        const resposta = await fetch(form.action, {
          method: 'POST',
          body: envio,
          headers: { Accept: 'application/json' },
        });
        const dados = await resposta.json().catch(() => null);

        if (resposta.ok && dados && dados.success) {
          /* El formulario se limpia pero los campos siguen bloqueados hasta que
             el modal cierre: ya no hay nada que hacer aquí, y un formulario
             vacío y editable justo después de enviar invita a rellenarlo otra
             vez — que acabaría en un 409 por duplicado. */
          form.reset();
          if (nomeArquivo) {
            nomeArquivo.textContent = '';
            nomeArquivo.hidden = true;
          }
          if (status) status.hidden = true;

          /* Cerrar deja de estar bloqueado ANTES de enseñar nada: a partir de
             aquí la persona puede salir con «Fechar», con el aspa o con Escape
             sin esperar al temporizador. */
          enviando = false;
          mostrarSucesso(String((dados && dados.petNome) || ''));

          /* Quien devuelve la tarjeta a su sitio es `restaurar()`, y la dispara
             el cierre — así da igual si se cierra por aquí o a mano. */
          temporizador = window.setTimeout(() => {
            temporizador = 0;
            fecharModal?.();
          }, ESPERA_ANTES_DE_FECHAR);
          return;
        } else {
          /* Mismo motivo que arriba: primero se devuelven los campos, y sólo
             entonces se marca y se enfoca el que el servidor señaló. */
          bloquearCampos(false);
          mostrar(
            (dados && dados.message) ||
              'Não foi possível enviar a inscrição. Tente novamente.',
            'erro'
          );
          if (dados && dados.campo) marcar(String(dados.campo));
        }
      } catch {
        mostrar('Falha de conexão. Verifique sua internet e tente de novo.', 'erro');
      } finally {
        /* El camino de éxito ya devolvió `enviando` a false y programó su propia
           limpieza para cuando cierre; aquí sólo se recupera el formulario
           cuando algo salió mal y la persona tiene que poder corregir. */
        if (enviando) {
          enviando = false;
          bloquearCampos(false);
          if (botao) {
            botao.disabled = false;
            botao.textContent = rotuloBotao;
          }
        }
      }
    });
  }
</script>
