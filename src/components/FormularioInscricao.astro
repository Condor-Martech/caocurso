---
/**
 * FORMULÁRIO DE INSCRIÇÃO — Cãocurso 2026.
 *
 * Tarjeta blanca redondeada sobre el lavanda, embebida en la página (en 2026 ya
 * no hay modal). Maquetado contra `docs/Desktop - CãoCurso.png`, medido a 1366 px:
 *
 *   tarjeta      x 220…1145 (926 px, centrada) · y 5213…6321 · radio ≈28 px
 *   contenido    x 286…1085 (800 px) → padding lateral ≈64 px, vertical ≈48 px
 *   dos columnas 332 px + hueco 65 px + 402 px  → ≈ 5fr / 6fr con gap-16
 *   campos       alto 44 px, radio píldora, contorno gris, placeholder gris
 *   textarea     alto ≈320 px, radio ≈20 px
 *   botón        336×60 px, azul sólido, texto blanco
 *
 * Neutros: la paleta 2026 no tiene gris, pero la referencia sí lo usa en el
 * contorno de los campos (#E9E9E9 muestreado) y en el placeholder (#A8A8A8).
 * Para no abrir la paleta con dos HEX nuevos se expresan como NEGRO CON ALFA
 * sobre blanco, que da exactamente esos dos valores: 9 % → #E9E9E9 y
 * 34 % → #A8A8A8. Son neutros de interfaz, no colores de marca.
 *
 * El checkbox de aceite NO está en el mockup: lo pidió el cliente y es
 * obligatorio por LGPD (regulamento + cesión de imagen del pet).
 *
 * Envío: POST multipart a /api/inscricao. Con JS lo intercepta el <script> de
 * abajo y pinta la respuesta en la propia tarjeta; sin JS el POST nativo sigue
 * funcionando (el usuario acaba en la respuesta JSON, feo pero no roto).
 */
---

<!-- Sin padding superior a propósito: el hueco con Atrações lo pone el pb de
     aquella sección, y las dos comparten el mismo fondo lavanda. -->
<section id="inscricao" class="bg-brand-purple pb-16 md:pb-20">
  <div class="container-lp">
    <div
      class="mx-auto w-full max-w-232 rounded-[28px] bg-white px-6 py-10 text-brand-blue shadow-xl md:px-16 md:py-12"
    >
      <h2
        class="mb-8 text-center text-3xl font-black tracking-tight sm:text-4xl md:mb-10 md:text-[2.5rem]"
      >
        Formulário de inscrição:
      </h2>

      <form
        id="form-inscricao"
        action="/api/inscricao"
        method="POST"
        enctype="multipart/form-data"
      >
        {/* ------------------------------------------------ Dados do Tutor */}
        <h3 class="mb-5 text-2xl font-bold md:text-[1.75rem]">Dados do Tutor</h3>

        <div class="grid grid-cols-1 gap-y-6 md:grid-cols-[5fr_6fr] md:gap-x-16 md:gap-y-9">
          <div class="md:col-span-2">
            <label class="sr-only" for="tutorNome">Nome completo</label>
            <input
              class="campo"
              type="text"
              id="tutorNome"
              name="tutorNome"
              placeholder="Nome completo"
              autocomplete="name"
              minlength="3"
              maxlength="120"
              required
            />
          </div>

          <div>
            <!-- type="text" y no type="date" a propósito: ver el <script>. -->
            <label class="sr-only" for="tutorNascimento">
              Data de nascimento, no formato dia/mês/ano
            </label>
            <input
              class="campo"
              type="text"
              id="tutorNascimento"
              name="tutorNascimento"
              placeholder="Data de nascimento"
              inputmode="numeric"
              pattern="\d{2}/\d{2}/\d{4}"
              title="Use o formato dd/mm/aaaa."
              maxlength="10"
              autocomplete="bday"
            />
          </div>

          <div>
            <label class="sr-only" for="tutorCpf">CPF cadastrado no Clube Condor</label>
            <input
              class="campo"
              type="text"
              id="tutorCpf"
              name="tutorCpf"
              placeholder="CPF cadastrado no Clube Condor"
              inputmode="numeric"
              maxlength="14"
            />
          </div>

          <div>
            <label class="sr-only" for="tutorEmail">E-mail</label>
            <input
              class="campo"
              type="email"
              id="tutorEmail"
              name="tutorEmail"
              placeholder="E-mail"
              autocomplete="email"
              maxlength="150"
              required
            />
          </div>

          <div>
            <label class="sr-only" for="tutorTelefone">Telefone com DDD</label>
            <input
              class="campo"
              type="tel"
              id="tutorTelefone"
              name="tutorTelefone"
              placeholder="Telefone"
              inputmode="tel"
              autocomplete="tel"
              maxlength="16"
              required
            />
          </div>
        </div>

        {/* -------------------------------------------------- Dados do Pet */}
        <h3 class="mt-10 mb-5 text-2xl font-bold md:mt-11 md:text-[1.75rem]">Dados do Pet</h3>

        <div class="grid grid-cols-1 gap-y-6 md:grid-cols-[5fr_6fr] md:gap-x-16 md:gap-y-9">
          <div class="md:col-span-2">
            <label class="sr-only" for="petNome">Nome do pet</label>
            <input
              class="campo"
              type="text"
              id="petNome"
              name="petNome"
              placeholder="Nome do pet"
              maxlength="60"
              required
            />
          </div>

          <div>
            <label class="sr-only" for="petRaca">Raça</label>
            <input
              class="campo"
              type="text"
              id="petRaca"
              name="petRaca"
              placeholder="Raça"
              maxlength="60"
            />
          </div>

          <div>
            <label class="sr-only" for="petSexo">Sexo</label>
            <input
              class="campo"
              type="text"
              id="petSexo"
              name="petSexo"
              placeholder="Sexo"
              maxlength="20"
            />
          </div>

          <div class="md:col-span-2">
            <label class="sr-only" for="petDescricao">
              Descreva seu pet: personalidade, curiosidades, etc.
            </label>
            <textarea
              class="campo campo--area"
              id="petDescricao"
              name="petDescricao"
              rows="6"
              maxlength="1000"
              placeholder="Descreva seu pet (personalidade, curiosidades, etc)"></textarea>
          </div>
        </div>

        {/* ------------------------------------- Aceite (LGPD) — no mockup */}
        <div class="aceite mt-7">
          <input
            class="aceite__box"
            type="checkbox"
            id="aceiteRegulamento"
            name="aceiteRegulamento"
            required
          />
          <!-- Cuando exista el PDF de 2026 (SITE.regulamentoDisponivel), la
               palabra «regulamento» debe pasar a ser un enlace al documento. -->
          <label class="aceite__texto" for="aceiteRegulamento">
            Li e aceito o regulamento do Cãocurso 2026 e autorizo a Rede Condor a usar a
            imagem do meu pet e os dados enviados na divulgação da campanha.
          </label>
        </div>

        {/* ------------------------------------------- Retorno para o usuário */}
        <div class="status mt-6" data-status role="status" aria-live="polite" hidden></div>

        {/* ------------------------------------------- Foto + envio */}
        <div class="mt-7 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
          <div class="w-full md:w-auto">
            <div class="arquivo">
              <input
                class="arquivo__input"
                type="file"
                id="petFoto"
                name="petFoto"
                accept="image/jpeg,image/png,image/webp"
                aria-describedby="petFoto-ajuda"
                required
              />
              <label class="arquivo__pill" for="petFoto">
                <svg
                  class="arquivo__clipe"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path
                    d="M21.44 11.05 12.25 20.24a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"
                  ></path>
                </svg>
                <span>Anexar foto do pet</span>
              </label>
            </div>

            <p class="arquivo__nome" data-arquivo aria-live="polite" hidden></p>
            <p class="arquivo__ajuda" id="petFoto-ajuda">O arquivo deve ter no máximo, 2mb.</p>
          </div>

          <button class="btn-enviar" type="submit" data-enviar>Enviar inscrição</button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  /* `hidden` tiene que ganar a los display de más abajo: van en el mismo nivel
     de especificidad y sin esto el contenedor de estado se vería siempre. */
  [hidden] {
    display: none !important;
  }

  #inscricao {
    /* Neutros de interfaz, no colores de marca. Negro con alfa sobre el blanco
       de la tarjeta = exactamente los valores muestreados en la referencia:
       9 % → #E9E9E9 (contorno) · 34 % → #A8A8A8 (placeholder y texto de ayuda). */
    --campo-borda: rgb(0 0 0 / 0.09);
    --campo-suave: rgb(0 0 0 / 0.34);
  }

  /* El foco global de la LP es un contorno BLANCO, pensado para los fondos de
     color; dentro de la tarjeta blanca sería invisible. Aquí manda el azul. */
  #inscricao :focus-visible {
    outline: 3px solid var(--c-blue);
    outline-offset: 2px;
    border-radius: 9999px;
  }

  /* ------------------------------------------------------------- campos */

  .campo {
    width: 100%;
    /* La referencia dibuja un contorno de 4 px; a 2 px sigue leyéndose igual de
       nítido sin engordar la píldora, que mide 44 px de alto. */
    border: 2px solid var(--campo-borda);
    border-radius: 9999px;
    background-color: var(--c-white);
    color: var(--c-blue);
    font-family: inherit;
    /* 16 px en móvil no es capricho: por debajo de eso iOS hace zoom al enfocar. */
    font-size: 1rem;
    line-height: 1.5;
    padding: 0.5rem 1.25rem;
    /* «CPF cadastrado no Clube Condor» no cabe en una píldora de 360 px, y
       bajar el cuerpo por debajo de 16 px dispararía el zoom de iOS. Con esto
       el recorte se lee como recorte y no como un corte a mitad de letra. */
    text-overflow: ellipsis;
    transition: border-color 0.15s ease;
  }

  .campo::placeholder {
    color: var(--campo-suave);
    opacity: 1; /* Firefox lo baja a 0.54 por su cuenta */
  }

  .campo:hover {
    border-color: rgb(0 0 0 / 0.18);
  }

  .campo:focus {
    border-color: var(--c-blue);
    outline: none;
  }

  .campo[aria-invalid='true'] {
    border-color: var(--c-red);
  }

  .campo--area {
    border-radius: 1.25rem;
    padding: 0.875rem 1.25rem;
    min-height: 10rem;
    resize: vertical;
  }

  /* --------------------------------------------------------- aceite LGPD */

  .aceite {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .aceite__box {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.125rem;
    accent-color: var(--c-blue);
    cursor: pointer;
  }

  .aceite__box[aria-invalid='true'] {
    outline: 2px solid var(--c-red);
    outline-offset: 2px;
  }

  .aceite__box[aria-invalid='true'] ~ .aceite__texto {
    color: var(--c-red);
  }

  .aceite__texto {
    color: var(--c-blue);
    font-size: 0.8125rem;
    line-height: 1.45;
    cursor: pointer;
  }

  /* ----------------------------------------------------- anexar foto */

  /* El <input type="file"> va PRIMERO y en absoluto, transparente, cubriendo
     toda la píldora: así recibe el clic directamente y —a diferencia de un
     .sr-only— tiene caja real, que es lo que Chrome necesita para anclar el
     globo de validación de `required`. Con .sr-only el envío se bloqueaba en
     silencio ("An invalid form control is not focusable").
     Al ir antes que el <label> se puede estilar la píldora con `~`, sin :has(). */
  .arquivo {
    position: relative;
    display: block;
    width: 100%;
  }

  .arquivo__input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 1;
  }

  .arquivo__pill {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
    border: 2px solid var(--campo-borda);
    border-radius: 9999px;
    padding: 0.5rem 1.5rem;
    color: var(--campo-suave);
    font-size: 1rem;
    line-height: 1.5;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .arquivo__clipe {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }

  .arquivo__input:hover ~ .arquivo__pill {
    border-color: rgb(0 0 0 / 0.18);
  }

  .arquivo__input:focus-visible ~ .arquivo__pill {
    outline: 3px solid var(--c-blue);
    outline-offset: 2px;
  }

  .arquivo__input[aria-invalid='true'] ~ .arquivo__pill {
    border-color: var(--c-red);
    color: var(--c-red);
  }

  .arquivo__nome {
    margin-top: 0.375rem;
    color: var(--c-blue);
    font-size: 0.75rem;
    font-weight: 700;
    word-break: break-all;
  }

  .arquivo__ajuda {
    margin-top: 0.25rem;
    color: var(--campo-suave);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  /* ------------------------------------------------------------ estado */

  .status {
    border-radius: 1rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .status[data-estado='enviando'] {
    border: 2px solid var(--campo-borda);
    color: var(--c-blue);
  }

  .status[data-estado='ok'] {
    background-color: var(--c-blue);
    color: var(--c-white);
  }

  .status[data-estado='erro'] {
    background-color: var(--c-red);
    color: var(--c-white);
  }

  /* ------------------------------------------------------------ enviar */

  .btn-enviar {
    width: 100%;
    border-radius: 9999px;
    background-color: var(--c-blue);
    color: var(--c-white);
    font-family: inherit;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    padding: 0.875rem 2.5rem;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      opacity 0.15s ease;
  }

  .btn-enviar:hover {
    background-color: var(--c-blue-deep);
  }

  .btn-enviar:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  @media (min-width: 768px) {
    .campo,
    .arquivo__pill {
      font-size: 1.125rem;
    }

    .campo--area {
      min-height: 19rem;
    }

    .aceite__texto {
      font-size: 0.875rem;
    }

    .arquivo {
      width: auto;
    }

    .arquivo__pill {
      width: auto;
      justify-content: flex-start;
    }

    .btn-enviar {
      width: auto;
      font-size: 1.75rem;
      padding: 0.875rem 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .campo,
    .arquivo__pill,
    .btn-enviar {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Envío sin salir de la página.
   *
   * Sin este script el <form> hace un POST nativo y el usuario termina mirando
   * el JSON crudo de la API en una pestaña en blanco. Con él: fetch multipart,
   * botón bloqueado mientras va, respuesta pintada en la tarjeta y el campo que
   * la API señala (`campo`) marcado en rojo. Si el JS no carga, el POST nativo
   * sigue existiendo: nada de esto es un requisito para poder inscribirse.
   *
   * Por qué la fecha es type="text" y no type="date":
   *   1. type="date" no admite placeholder — siempre enseña «dd/aaaa/mm» del
   *      navegador y rompe la composición de la referencia, que muestra
   *      «Data de nascimento» en gris como todos los demás campos.
   *   2. Es una fecha de NACIMIENTO: el selector nativo abre en el mes actual y
   *      obliga a retroceder décadas. Teclear 8 dígitos con el teclado numérico
   *      es más rápido en móvil, y el `inputmode="numeric"` ya lo levanta.
   *   3. El widget nativo es inconsistente entre navegadores (rueda en iOS,
   *      tres cajitas en Firefox), así que ni siquiera se gana coherencia.
   * A cambio se añade una máscara dd/mm/aaaa y el `pattern` protege también el
   * camino sin JS. El servidor acepta las dos formas, dd/mm/aaaa y aaaa-mm-dd,
   * por si algún día se cambia de idea.
   */

  const MAX_FOTO_BYTES = 2 * 1024 * 1024;

  const form = document.querySelector<HTMLFormElement>('#form-inscricao');
  if (form) iniciar(form);

  function iniciar(form: HTMLFormElement) {
    const botao = form.querySelector<HTMLButtonElement>('[data-enviar]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const inputFoto = form.querySelector<HTMLInputElement>('#petFoto');
    const nomeArquivo = form.querySelector<HTMLElement>('[data-arquivo]');
    const rotuloBotao = botao ? botao.textContent : '';
    let enviando = false;

    /* ---------------------------------------------------------- máscaras */

    const mascarar = (id: string, formatar: (digitos: string) => string) => {
      const el = form.querySelector<HTMLInputElement>(`#${id}`);
      if (!el) return;
      el.addEventListener('input', () => {
        const noFim = el.selectionStart === el.value.length;
        el.value = formatar(el.value.replace(/\D/g, ''));
        // Sólo se reposiciona el cursor si ya estaba al final; si el usuario
        // está corrigiendo en medio, se le deja donde estaba.
        if (noFim) el.setSelectionRange(el.value.length, el.value.length);
        limpar(el);
      });
    };

    // dd/mm/aaaa — nunca deja una barra colgando, así el borrado no se atasca.
    mascarar('tutorNascimento', (d) => {
      d = d.slice(0, 8);
      let saida = d.slice(0, 2);
      if (d.length > 2) saida += `/${d.slice(2, 4)}`;
      if (d.length > 4) saida += `/${d.slice(4)}`;
      return saida;
    });

    // 000.000.000-00
    mascarar('tutorCpf', (d) => {
      d = d.slice(0, 11);
      let saida = d.slice(0, 3);
      if (d.length > 3) saida += `.${d.slice(3, 6)}`;
      if (d.length > 6) saida += `.${d.slice(6, 9)}`;
      if (d.length > 9) saida += `-${d.slice(9)}`;
      return saida;
    });

    // (41) 3333-4444 · (41) 99999-8888
    mascarar('tutorTelefone', (d) => {
      d = d.slice(0, 11);
      if (!d) return '';
      const celular = d.length > 10;
      let saida = `(${d.slice(0, 2)}`;
      if (d.length > 2) saida += `) ${celular ? d.slice(2, 7) : d.slice(2, 6)}`;
      if (d.length > 6) saida += `-${celular ? d.slice(7) : d.slice(6)}`;
      return saida;
    });

    /* ------------------------------------------------------ marcas de erro */

    function limpar(el: Element) {
      el.removeAttribute('aria-invalid');
    }

    function limparTudo() {
      form.querySelectorAll('[aria-invalid]').forEach(limpar);
    }

    function marcar(campo: string) {
      const alvo = form.querySelector<HTMLElement>(`#${campo}`);
      if (!alvo) return;
      alvo.setAttribute('aria-invalid', 'true');
      alvo.focus();
    }

    // Al reescribir un campo señalado, se le quita la marca roja.
    form.querySelectorAll('input, textarea').forEach((el) => {
      el.addEventListener('input', () => limpar(el));
    });

    /* --------------------------------------------------- nome do arquivo */

    if (inputFoto) {
      inputFoto.addEventListener('change', () => {
        const arquivo = inputFoto.files && inputFoto.files[0];
        if (nomeArquivo) {
          nomeArquivo.textContent = arquivo ? arquivo.name : '';
          nomeArquivo.hidden = !arquivo;
        }
        // Se avisa del tamaño aquí y no tras subir 8 MB por una red móvil.
        if (arquivo && arquivo.size > MAX_FOTO_BYTES) {
          inputFoto.setAttribute('aria-invalid', 'true');
          mostrar('A foto deve ter no máximo 2 MB. Escolha outra imagem.', 'erro');
        }
      });
    }

    /* ----------------------------------------------------------- estado */

    function mostrar(texto: string, estado: 'enviando' | 'ok' | 'erro') {
      if (!status) return;
      status.textContent = texto;
      status.dataset.estado = estado;
      status.hidden = false;
    }

    /* ----------------------------------------------------------- envio */

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      if (enviando) return;

      const arquivo = inputFoto && inputFoto.files && inputFoto.files[0];
      if (arquivo && arquivo.size > MAX_FOTO_BYTES) {
        marcar('petFoto');
        mostrar('A foto deve ter no máximo 2 MB. Escolha outra imagem.', 'erro');
        return;
      }

      enviando = true;
      limparTudo();
      if (botao) {
        botao.disabled = true;
        botao.textContent = 'Enviando…';
      }
      mostrar('Enviando sua inscrição…', 'enviando');

      try {
        const resposta = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const dados = await resposta.json().catch(() => null);

        if (resposta.ok && dados && dados.success) {
          mostrar(dados.message || 'Inscrição enviada com sucesso!', 'ok');
          form.reset();
          if (nomeArquivo) {
            nomeArquivo.textContent = '';
            nomeArquivo.hidden = true;
          }
        } else {
          mostrar(
            (dados && dados.message) ||
              'Não foi possível enviar a inscrição. Tente novamente.',
            'erro'
          );
          if (dados && dados.campo) marcar(String(dados.campo));
        }
      } catch {
        mostrar('Falha de conexão. Verifique sua internet e tente de novo.', 'erro');
      } finally {
        enviando = false;
        if (botao) {
          botao.disabled = false;
          botao.textContent = rotuloBotao;
        }
      }
    });
  }
</script>
