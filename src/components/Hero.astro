---
/**
 * HERO — dos bloques. El de la campaña, fijo; el de las mascotas, carrusel.
 *
 *   ┌────────────────────────────┬──────────────────────────────┐
 *   │  [ MÊS PET ]               │  [selo oferta] [mote]        │
 *   │                            │  datos                       │
 *   │  PREÇO BAIXO               │  ( CTA )                     │
 *   │  PRA CACHORRO              │            ,-.               │
 *   │  e pra gatos também!       │          (mascota)           │
 *   │                            │  ● Cãocurso  ○ Adote AuMigo  │
 *   │  ── FIJO ──────────────────│  ── DESLIZA ─────────────────│
 *   └────────────────────────────┴──────────────────────────────┘
 *
 * DECISIONES
 *
 * · La columna izquierda NO se toca nunca. Es la campaña: el sello Mês Pet y su
 *   claim de precios. Si parpadeara cada 7 s la marca dejaría de ser el ancla
 *   del hero, y además es el elemento LCP: cada cambio de slide obligaría a
 *   recomponer la zona más pesada de la página.
 *
 * · Todo lo que cambia entre oferta y oferta vive en la columna derecha, dentro
 *   de la pista: identidad, datos, CTA y mascota. Si algo de eso se quedara en
 *   la izquierda, la parte fija dejaría de ser fija.
 *
 * · Dos slides, los dos con CTA. El carrusel es un escaparate, no la única
 *   puerta a nada: la adopción tiene el bloque 2 entero y el Cãocurso la banda
 *   del bloque 6 más el formulario. Orden fijo, Cãocurso delante: su ventana de
 *   inscripción es la que caduca (03/08–21/08).
 *
 * · Los controles —flechas y contador— SÓLO existen de tablet en horizontal
 *   para arriba. En móvil la pantalla es el recurso escaso y ahí sobran: la
 *   pista se pasa con el dedo y la rotación automática enseña la segunda
 *   oferta sola. Ese carril de abajo es el que le da cuerpo al sello.
 *
 * · Funciona SIN JavaScript: la pista es `scroll-snap` nativo y se pasa con el
 *   dedo o con la rueda aunque el script no cargue. El JS sólo añade la
 *   rotación automática, las pestañas y la barra de progreso.
 *
 * · Reparto de fotos sin repetir: `dogs.webp` y `dog-caramelo.webp` no se
 *   servían hasta ahora. `caocurso-dogs.webp` se queda en exclusiva para el
 *   bloque 6 y `Dog.png` para el bloque 2, donde cruza la faixa.
 *
 * ALTURA: el hero mide EXACTAMENTE una pantalla (`--hero-h`) y las dos
 * diapositivas comparten esa altura, así que cambiar de slide no mueve ni un
 * píxel del resto de la página.
 */
import { caocurso as caocursoSite, eventos, hero } from '../data/site';

const prazo = `${caocursoSite.inscricaoRotulo} ${caocursoSite.inscricaoPeriodo.replace(/\.$/, '')}`;

/* Los dos slides salen de site.json. Las fechas NO: el del Cãocurso las toma de
   `caocurso` y el de adopción las compone desde `eventos`, que son las mismas
   que pintan los bloques 3 y 7. Duplicarlas en el JSON sería garantizar que un
   día discrepen. */
const [slideCao, slideAdote] = hero.slides;
---

<section
  id="conteudo"
  class="hero bg-patron relative overflow-hidden bg-brand-blue-sec text-brand-white"
>
  <div class="container-lp hero-grade">
    <!-- ══ Bloque 1 · Campaña — FIJO ═════════════════════════════════════ -->
    <div class="bloco-fixo">
      <img
        src={hero.selo.src}
        alt={hero.selo.alt}
        class="selo-mespet"
        width={hero.selo.largura}
        height={hero.selo.altura}
        fetchpriority="high"
      />

      <!-- Lettering, no tipografía: el "e pra gatos também!" es caligráfico y
           ninguna variante de Torus lo reproduce. -->
      <img
        src={hero.mote.src}
        alt={hero.mote.alt}
        class="mote-mespet"
        width={hero.mote.largura}
        height={hero.mote.altura}
        fetchpriority="high"
      />
    </div>

    <!-- ══ Bloque 2 · Ofertas — CARRUSEL ═════════════════════════════════ -->
    <div
      class="bloco-slider"
      aria-roledescription="carrossel"
      aria-label={hero.aria.carrossel}
    >
      <div class="pista" id="hero-pista" tabindex="0" aria-label={hero.aria.pista}>
        <!-- ── Slide 1 · Cãocurso ─────────────────────────────────────── -->
        <article
          class="slide"
          role="group"
          aria-roledescription="slide"
          aria-label={slideCao.aria}
        >
          <div class="oferta">
            <h1 class="linha-logo">
              <img
                src={slideCao.logo.src}
                alt={slideCao.logo.alt}
                class="selo-oferta"
                width={slideCao.logo.largura}
                height={slideCao.logo.altura}
                fetchpriority="high"
              />
            </h1>

            <div class="linha-msg">
              <img
                src={slideCao.mote!.src}
                alt={slideCao.mote!.alt}
                class="mote-oferta"
                width={slideCao.mote!.largura}
                height={slideCao.mote!.altura}
                fetchpriority="high"
              />
            </div>

            <!-- Datos, nunca botones: el amarillo es de un único elemento. -->
            <p class="dados">
              <strong>{caocursoSite.data}</strong>
              <strong>{caocursoSite.horario}</strong>
              <strong>{caocursoSite.local}</strong>
            </p>

            <div class="acao">
              {/* Ancla al bloque del Cãocurso, que es donde vive el botón de
                  inscripción con sus tres estados. Este CTA no abre el modal:
                  lleva hasta él. Antes apuntaba a #formulario-inscricao, un id
                  que no existe en ninguna página — el enlace no hacía nada. */}
              <a href={slideCao.cta.href} class="btn-lp btn-primario">
                {slideCao.cta.rotulo}
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </a>
              <p class="nota">{prazo}</p>
            </div>
          </div>
        </article>

        <!-- ── Slide 2 · Adote um AuMigo ──────────────────────────────── -->
        <article
          class="slide"
          role="group"
          aria-roledescription="slide"
          aria-label={slideAdote.aria}
        >
          <div class="oferta">
            <h2 class="linha-logo">
              <img
                src={slideAdote.logo.src}
                alt={slideAdote.logo.alt}
                class="selo-aumigo"
                width={slideAdote.logo.largura}
                height={slideAdote.logo.altura}
                loading="lazy"
                decoding="async"
              />
            </h2>

            <div class="linha-msg">
              <p class="claim">{slideAdote.claim}</p>
            </div>

            <p class="dados">
              {
                eventos.map((e) => (
                  <strong>
                    {e.dia}/08 {e.local.replace('Condor ', '')}
                  </strong>
                ))
              }
            </p>

            <div class="acao">
              <a href={slideAdote.cta.href} class="btn-lp btn-claro">{slideAdote.cta.rotulo}</a>
              <p class="nota">{slideAdote.nota}</p>
            </div>
          </div>
        </article>
      </div>

      <!-- Flechas. Van FLANQUEANDO la oferta y centradas en vertical: el
           bloque queda entre ellas y deja de leerse disperso.
           WCAG 2.2.2 — la rotación se congela con el ratón encima y con el foco
           dentro, y se para del todo en cuanto alguien pulsa una flecha o el
           botón de pausa, que es el único control que queda suelto. -->
      <button type="button" class="seta seta--ant" id="hero-ant" aria-label={hero.aria.anterior}>
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 5l-7 7 7 7"></path>
        </svg>
      </button>

      <button type="button" class="seta seta--seg" id="hero-seg" aria-label={hero.aria.seguinte}>
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <div class="estado" id="hero-controles">
        <span class="conta"><span id="hero-atual">1</span>/2</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* ══ Caja ════════════════════════════════════════════════════════════════
     Alto EXACTO de una pantalla. Es `height` y no `min-height` porque la pista
     y las diapositivas necesitan una altura definida para ocuparla entera; el
     suelo de 32rem evita que en una ventana bajísima se aplaste. */
  .hero {
    height: var(--hero-h);
    min-height: 32rem;

    /* Alturas de las filas de la diapositiva. Móvil primero.
       El sello del Cãocurso pide más cuerpo que el resto: en el móvil es lo
       único que identifica de qué va la tarjeta, y a 117 px se leía como un
       icono. El sitio para crecer sale de las flechas, que en esta anchura ya
       no se pintan. */
    --h-logo: min(38vw, 168px, calc(var(--hero-h) * 0.22));
    --h-msg: min(50vw, 110px, calc(var(--hero-h) * 0.13));
    --h-dados: 3.2rem;
  }

  /* Ventanas bajas: con los factores de arriba la tarjeta pedía 404 px y la
     pista sólo tiene 335, así que la pista —que lleva `overflow-y: hidden`—
     recortaba en silencio por los dos extremos: el logo del concurso por arriba
     y el «Período de inscrição» por abajo. Se ve como una tarjeta cortada, no
     como un desbordamiento.

     Va por ALTO de ventana, no por ancho: el que se queda sin sitio es el eje
     vertical. */
  @media (max-height: 700px) {
    .hero {
      --h-logo: min(32vw, 132px, calc(var(--hero-h) * 0.16));
      --h-msg: min(40vw, 84px, calc(var(--hero-h) * 0.085));
      --h-dados: 2.5rem;
    }
  }

  .hero-grade {
    display: grid;
    height: 100%;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0.5rem;
    padding-top: 1rem;
    padding-bottom: 0.75rem;
  }

  /* ── Bloque fijo ──────────────────────────────────────────────────────── */
  .bloco-fixo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  /* En móvil el sello y su claim SON el título de la página: no hay nav ni
     titular de texto por encima, así que si no pesan, la primera pantalla no
     dice de quién es. Van al ancho que permite la caja —de ahí los 44vw y
     60vw—, con el tercer término atado a `--hero-h` para que en una pantalla
     baja encojan antes de empujar la tarjeta. */
  .selo-mespet {
    width: min(44vw, 176px, calc(var(--hero-h) * 0.19));
    filter: drop-shadow(0 14px 28px rgb(0 0 0 / 0.32));
  }

  .mote-mespet {
    width: min(60vw, 240px, calc(var(--hero-h) * 0.28));
  }

  /* ── Bloque carrusel ──────────────────────────────────────────────────── */
  /* `min-width: 0` no es decorativo: un ítem de grid —y uno de flex— no baja por
     defecto del min-content de lo que lleva dentro. Con los `white-space: nowrap`
     de las fechas, ese mínimo son 356 px, así que a 320 el bloque se salía 84 px
     por la derecha y la tarjeta aparecía cortada: «21/08/20…». No se veía como
     desbordamiento de la página porque la sección lleva `overflow-hidden`, que
     lo recortaba en silencio.
     Es el mismo motivo por el que ya estaba el `min-height: 0`, en el otro eje. */
  .bloco-slider {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    padding-top: 0.75rem;
    /* Sin flechas ni contador debajo no hay carril que reservar: esos 2,5rem
       eran su sitio. Se devuelven a la tarjeta y al título. */
    padding-bottom: 0.5rem;
  }

  /* Segunda mitad del recorte para pantallas bajas. Va aquí, y no arriba junto
     al `max-height` que ajusta las filas, porque estas reglas tienen que ir
     DESPUÉS de las que corrigen: misma especificidad, gana la última.
     Medido en 360×640 la tarjeta se quedaba a 5 px de la pista; el aire sale
     del interlineado de la retícula y del carril del carrusel, no del sello,
     que es lo que hay que poder leer. */
  @media (max-height: 700px) {
    .selo-mespet {
      width: min(38vw, 140px, calc(var(--hero-h) * 0.17));
    }

    .mote-mespet {
      width: min(52vw, 208px, calc(var(--hero-h) * 0.26));
    }

    .hero-grade {
      gap: 0.35rem;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .bloco-slider {
      padding-top: 0.35rem;
    }
  }

  .pista {
    display: flex;
    min-width: 0;
    min-height: 0;
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  .pista::-webkit-scrollbar {
    display: none;
  }

  /* El foco del teclado cae en la pista, que es un contenedor desplazable. */
  .pista:focus-visible {
    outline: 3px solid var(--c-white);
    outline-offset: -3px;
  }

  .slide {
    display: flex;
    height: 100%;
    min-width: 0;
    flex: 0 0 100%;
    flex-direction: column;
    justify-content: center;
    scroll-snap-align: start;
  }

  /* Panel del KV, no una card de sistema. El cristal se retiró: en esta página
     no hay ni un elemento más hecho de material —todo es vectorial plano, canto
     duro y color liso—, así que un panel translúcido con desenfoque obedecía a
     otra física y se leía pegado de otro sitio. Y al ser transparente enseñaba
     LA MISMA trama a la MISMA escala, sólo que borrosa: no había cambio de
     plano, era una mancha sobre el fondo.
     Ahora es una plancha opaca en --c-blue con el line-art de la campaña en
     blanco por encima. Mismo motivo que el fondo pero en negativo, así que se
     lee inequívocamente como una pieza por delante. La profundidad la da la
     sombra, que es como el arte original resuelve la profundidad. */
  .oferta {
    display: flex;
    position: relative;
    width: 100%;
    max-width: 30rem;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    isolation: isolate;
    margin-inline: auto;
    gap: 0.55rem;
    border-radius: 1.75rem;
    background: var(--c-blue);
    padding: 0.9rem 1rem 1rem;
    text-align: center;
    box-shadow:
      0 20px 38px -18px rgb(0 0 0 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.12);
  }

  /* La trama va en una capa aparte para poder graduarla desde aquí: como capa
     de `background` no hay forma de bajarle la opacidad sin regenerar el WebP.
     `trama-linhas.webp` se extrajo del propio `bg-mespet.webp` —un paso alto
     sobre el degradado azul— así que es literalmente el mismo dibujo. */
  .oferta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: url('/assets/2026/trama-linhas.webp') center / cover no-repeat;
    opacity: 0.1;
  }

  /* Pantallas de 320: el CTA se parte en dos líneas y la nota también, así que
     la tarjeta pedía unos 48 px más de los que tiene la pista y ésta recortaba
     por los dos extremos —el sello del Cãocurso por arriba, la fecha de cierre
     por abajo—. Ya pasaba antes de agrandar nada; aquí se cierra apretando lo
     prescindible (aire y relleno) en vez de encoger el sello, que es
     precisamente lo que hay que leer. */
  @media (max-width: 359px) {
    .oferta {
      gap: 0.3rem;
      padding: 0.6rem 0.7rem 0.7rem;
    }
  }

  /* Tablet en vertical: la columna del carrusel es altísima y el panel, a alto
     completo, se estiraba a casi 600 px con el contenido flotando en medio. El
     tope lo deja en una caja proporcionada; en móvil no llega a activarse y en
     escritorio la columna nunca da para tanto. */
  @media (orientation: portrait) and (min-width: 600px) {
    .oferta {
      max-height: 28rem;
    }
  }

  /* Las dos diapositivas comparten RETÍCULA, no sólo caja: el logo, el mensaje,
     los datos y el botón caen a la misma altura en las dos. Por eso las filas
     llevan alto fijo en vez de ajustarse a su contenido — el sello del Cãocurso
     es casi cuadrado (0,90) y el de AuMigo apaisado (0,73), así que a igual
     ancho tendrían alturas distintas y el CTA bailaría al rotar. Se igualan por
     ALTO y cada uno toma el ancho que le pida su proporción. */
  .linha-logo,
  .linha-msg {
    display: grid;
    width: 100%;
    place-items: center;
  }

  .linha-logo {
    height: var(--h-logo);
  }

  .linha-msg {
    height: var(--h-msg);
  }

  .selo-oferta,
  .selo-aumigo {
    max-height: var(--h-logo);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: drop-shadow(0 8px 16px rgb(0 0 0 / 0.22));
  }

  .mote-oferta {
    max-height: var(--h-msg);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .claim {
    max-width: 22rem;
    font-size: clamp(1rem, 1.4vw, 1.3125rem);
    font-weight: 700;
    line-height: 1.2;
  }

  /* Los datos en una línea: en el hero son una referencia rápida, no una
     ficha. Sin fondo ni radio — nada de esto puede leerse como pulsable. */
  .dados {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    align-content: center;
    height: var(--h-dados);
    gap: 0.35rem 1.35rem;
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    font-weight: 900;
  }

  .dados strong {
    white-space: nowrap;
  }

  .acao {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .nota {
    font-size: 0.8125rem;
    font-weight: 600;
    opacity: 0.85;
  }

  /* ══ Flechas ═════════════════════════════════════════════════════════════
     Flanquean la oferta en vez de acumularse en una barra al pie. Puestas a los
     lados hacen de paréntesis: el bloque queda centrado ENTRE ellas, que es lo
     que le quita la sensación de disperso.

     EN MÓVIL NO SE PINTAN. Ahí la pista se pasa con el dedo —es `scroll-snap`
     nativo, no hace falta JavaScript— y la rotación automática enseña la
     segunda oferta sola, así que las flechas sólo estaban gastando la franja
     inferior de la única pantalla que tenemos. Siguen en el DOM: el script las
     escucha igual y el contador guarda el estado de la rotación. */
  .seta {
    position: absolute;
    bottom: 0;
    z-index: 3;
    display: none;
    height: 2.1rem;
    width: 2.1rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    color: var(--c-white);
    cursor: pointer;
    transition:
      background 200ms ease,
      scale 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .seta:hover {
    background: rgb(255 255 255 / 0.3);
    scale: 1.08;
  }

  .seta--ant {
    inset-inline-start: calc(50% - 5rem);
  }

  .seta--seg {
    inset-inline-end: calc(50% - 5rem);
  }

  /* Aro de progreso de la flecha "siguiente": avisa de que aquello se va a
     mover ANTES de moverse, sin necesidad de una barra aparte. */
  .seta--seg::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 999px;
    background: conic-gradient(var(--c-orange-lite) var(--avance, 0turn), transparent 0);
    -webkit-mask:
      radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    animation: gira 7s linear infinite;
  }

  .estado[data-parado='true'] ~ .seta--seg::before,
  .estado[data-pausado='true'] ~ .seta--seg::before {
    animation-play-state: paused;
  }

  .estado[data-parado='true'] ~ .seta--seg::before {
    opacity: 0;
  }

  @property --avance {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0turn;
  }

  @keyframes gira {
    from {
      --avance: 0turn;
    }
    to {
      --avance: 1turn;
    }
  }

  /* ══ Contador + pausa ════════════════════════════════════════════════════
     Lo único que queda suelto: cuántas hay y cómo parar la rotación. Discreto,
     en la esquina, no una barra de controles. */
  .estado {
    position: absolute;
    z-index: 3;
    display: none;
    align-items: center;
    gap: 0.55rem;
    inset-block-end: 0;
    inset-inline-start: 50%;
    translate: -50% 0;
  }

  .conta {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    opacity: 0.75;
    font-variant-numeric: tabular-nums;
  }

  /* ══ Botones ═════════════════════════════════════════════════════════════
     Un solo elemento amarillo en toda la pantalla: el CTA de inscripción. */
  .btn-primario,
  .btn-claro {
    display: inline-flex;
    /* Mismo alto los dos: el primario lleva más cuerpo y más relleno que el
       secundario, y esa diferencia desplazaba 1,3 px toda la pila centrada,
       así que el CTA no caía exactamente a la misma altura al cambiar de
       diapositiva. */
    min-height: 3.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border-radius: 999px;
    font-weight: 900;
    text-align: center;
    transition: all 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-primario svg {
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-primario:hover svg {
    transform: translateX(5px);
  }

  .btn-primario {
    background: var(--c-orange-lite);
    color: var(--c-blue);
    padding: 0.9rem 1.9rem;
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.45);
  }

  .btn-primario:hover {
    background: var(--c-orange-pan);
  }

  .btn-claro {
    background: var(--c-white);
    color: var(--c-blue);
    padding: 0.85rem 1.8rem;
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.35);
  }

  .btn-claro:hover {
    background: var(--c-orange-lite);
  }

  /* La otra mitad del apaño de 320 px: con este cuerpo y este relleno «Quero
     inscrever meu pet» cabe en UNA línea, que es la que sobraba. Va aquí abajo
     y no junto a la regla de `.oferta` porque las de los botones se declaran
     después: a igual especificidad manda la última, y puesta arriba no pintaba
     nada. */
  @media (max-width: 359px) {
    .btn-primario,
    .btn-claro {
      min-height: 2.9rem;
      padding-inline: 1.1rem;
      font-size: 0.9375rem;
    }

    /* Los 28 px de la flecha son los que partían el rótulo en dos. Es
       decorativa —ya va `aria-hidden`—, así que a este ancho se cae ella antes
       que el texto. */
    .btn-primario svg {
      display: none;
    }
  }

  /* ══ Dos columnas ════════════════════════════════════════════════════════
     La condición es la misma que la variante `fila:` de global.css —ancho Y
     orientación—, porque en un iPad vertical las dos columnas dejarían media
     pantalla de textura vacía. */
  @media (min-width: 768px) and (orientation: landscape), (min-width: 1024px) {
    .hero {
      --h-logo: min(20vw, 250px, calc(var(--hero-h) * 0.32));
      --h-msg: min(11vw, 140px, calc(var(--hero-h) * 0.18));
      --h-dados: 3.4rem;
    }

    .hero-grade {
      grid-template-rows: minmax(0, 1fr);
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 2rem;
      padding-top: 2vh;
      padding-bottom: 1vh;
    }

    .bloco-fixo {
      align-items: flex-start;
      justify-content: center;
      gap: 1rem;
      /* Arrimado al borde. El tirón se come la sangría del contenedor —48 px en
         escritorio— para que el arte llegue al canto, pero MENGUA con el ancho:
         a 1024 el contenedor ya está pegado a la ventana y un tirón fijo dejaba
         el rótulo a 12 px del borde. El `-1rem` del término central reserva ese
         margen mínimo. */
      margin-inline-start: calc(-1 * clamp(1rem, 3.5vw - 1rem, 3rem));
      text-align: start;
    }

    .selo-mespet {
      width: min(27vw, 356px, calc(var(--hero-h) * 0.45));
    }

    .mote-mespet {
      width: min(26vw, 346px, calc(var(--hero-h) * 0.43));
    }

    .oferta {
      align-items: center;
      padding: 1.4rem 1.9rem 1.6rem;
      text-align: center;
    }

    .oferta {
      gap: 0.9rem;
    }

    /* Carril para las flechas: sin él pisarían el lettering. Aquí sí vuelven
       —hay ancho de sobra a los lados y puntero con el que pulsarlas—, y con
       ellas el contador y el carril inferior que ocupa. */
    .bloco-slider {
      padding-top: 1.25rem;
      padding-bottom: 2.5rem;
      padding-inline: 2.75rem;
    }

    .estado {
      display: flex;
    }

    .seta {
      top: 50%;
      bottom: auto;
      display: inline-flex;
      height: 2.75rem;
      width: 2.75rem;
      translate: 0 -50%;
    }

    .seta--ant {
      inset-inline-start: -0.25rem;
    }

    .seta--seg {
      inset-inline-end: -0.25rem;
    }
  }

  /* ══ Movimiento reducido ═════════════════════════════════════════════════
     Ni rotación automática (la apaga el script) ni desplazamiento suave ni
     barra corriendo. El carrusel se queda en pestañas. */
  @media (prefers-reduced-motion: reduce) {
    .pista {
      scroll-behavior: auto;
    }

    .seta--seg::before {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  /**
   * Realce progresivo: sin este script el carrusel sigue siendo usable —la
   * pista es `scroll-snap` nativo— y sólo se pierden la rotación automática,
   * las pestañas y la barra de progreso.
   */
  const raiz = document.getElementById('conteudo');
  const pista = document.getElementById('hero-pista');
  const controles = document.getElementById('hero-controles');

  if (raiz && pista && controles) {
    const slides = Array.from(pista.querySelectorAll('.slide'));
    const conta = document.getElementById('hero-atual');
    const INTERVALO = 7000;

    const reduz = window.matchMedia('(prefers-reduced-motion: reduce)');

    let atual = 0;
    let voltas = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    /* `parado` es la decisión del usuario: al pulsar una flecha o el botón de
       pausa, la rotación no vuelve sola. Retomarla después de que alguien haya
       elegido es la forma más rápida de que cierre la pestaña. */
    let parado = reduz.matches;

    const marcar = (i: number) => {
      atual = i;
      if (conta) conta.textContent = String(i + 1);
    };

    const irA = (i: number) => {
      pista.scrollTo({
        left: pista.clientWidth * i,
        behavior: reduz.matches ? 'auto' : 'smooth',
      });
    };

    /* Sin botón de pausa visible, la rotación NO puede ser indefinida: da una
       vuelta completa —enseña las dos ofertas— y se queda quieta en la primera.
       Así el movimiento automático tiene final, en vez de un carrusel girando
       para siempre en la esquina del ojo. A partir de ahí manda el usuario con
       las flechas. */
    const arrancar = () => {
      if (parado || timer) return;
      timer = setInterval(() => {
        if (voltas >= slides.length) {
          parar();
          return;
        }
        voltas += 1;
        irA((atual + 1) % slides.length);
      }, INTERVALO);
      controles.removeAttribute('data-pausado');
    };

    /* Pausa temporal —ratón encima, foco dentro, pestaña del navegador oculta—:
       el aro de progreso se congela donde esté y se reanuda al salir. */
    const congelar = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
      if (!parado) controles.setAttribute('data-pausado', 'true');
    };

    /* Parada definitiva, la que decide el usuario. */
    const parar = () => {
      parado = true;
      congelar();
      controles.removeAttribute('data-pausado');
      controles.setAttribute('data-parado', 'true');
    };

    const retomar = () => {
      parado = false;
      controles.removeAttribute('data-parado');
      arrancar();
    };

    /* Quién está a la vista manda — también cuando se pasa con el dedo. */
    const observador = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (e.isIntersecting) marcar(slides.indexOf(e.target));
        });
      },
      { root: pista, threshold: 0.6 }
    );
    slides.forEach((s) => observador.observe(s));

    /* Las flechas dan la vuelta: con dos diapositivas, una flecha desactivada
       la mitad del tiempo es un control que engaña. */
    const mover = (paso: number) => {
      const destino = (atual + paso + slides.length) % slides.length;
      irA(destino);
      marcar(destino);
      parar();
    };

    document.getElementById('hero-ant')?.addEventListener('click', () => mover(-1));
    document.getElementById('hero-seg')?.addEventListener('click', () => mover(1));

    /* Deslizar con el dedo también es elegir — pero SÓLO deslizar.
       Antes esto era `pointerdown → parar`, y en móvil mataba la rotación al
       primer roce: la tarjeta ocupa casi todo el hero, así que el gesto normal
       de bajar por la página empieza encima de ella. `pointerdown` no distingue
       un swipe horizontal de un scroll vertical ni de un toque suelto.
       Ahora se mide el gesto al soltar: sólo cuenta si el recorrido horizontal
       supera el umbral Y es mayor que el vertical. */
    const UMBRAL_SWIPE = 24;
    let inicio: { x: number; y: number } | null = null;

    pista.addEventListener(
      'pointerdown',
      (e) => {
        inicio = { x: e.clientX, y: e.clientY };
      },
      { passive: true }
    );

    const fimDoGesto = (e: PointerEvent) => {
      if (!inicio) return;
      const dx = Math.abs(e.clientX - inicio.x);
      const dy = Math.abs(e.clientY - inicio.y);
      inicio = null;
      if (dx > UMBRAL_SWIPE && dx > dy) parar();
    };

    pista.addEventListener('pointerup', fimDoGesto, { passive: true });
    pista.addEventListener('pointercancel', () => (inicio = null), { passive: true });

    /* La pausa por puntero encima sólo tiene sentido donde hay puntero: en una
       pantalla táctil `pointerenter` se dispara al tocar, no al pasar por
       encima, así que aquí congelaba con cada toque. */
    if (window.matchMedia('(hover: hover)').matches) {
      raiz.addEventListener('pointerenter', congelar);
      raiz.addEventListener('pointerleave', arrancar);
    }

    /* Congelar mientras alguien navega con el teclado por dentro del hero es
       WCAG 2.2.2, y se queda. Pero SÓLO con teclado: la pista lleva
       `tabindex="0"`, así que tocarla con el dedo también le daba el foco, y
       como el foco se quedaba ahí `focusout` no llegaba nunca y la rotación se
       congelaba para siempre. `:focus-visible` es justamente la distinción que
       hace el navegador entre «llegué aquí con el teclado» y «me han tocado». */
    raiz.addEventListener('focusin', (e) => {
      const alvo = e.target;
      if (alvo instanceof Element && alvo.matches(':focus-visible')) congelar();
    });
    raiz.addEventListener('focusout', arrancar);

    document.addEventListener('visibilitychange', () =>
      document.hidden ? congelar() : arrancar()
    );

    /* Si el usuario activa "reducir movimiento" con la página ya abierta. */
    reduz.addEventListener('change', () => (reduz.matches ? parar() : retomar()));

    if (parado) controles.setAttribute('data-parado', 'true');
    arrancar();
  }
</script>
