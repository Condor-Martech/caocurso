---
/**
 * CÃOCURSO — logo y tagline a la izquierda, el chihuahua a la derecha.
 * El tagline "Seu pet é a estrela da nossa passarela." es una IMAGEN
 * (magenta con contorno blanco), no texto.
 */
---

<section id="caocurso" class="bg-patron relative bg-[var(--c-orange)]">
  <div
    class="container-lp grid grid-cols-1 items-center justify-items-center gap-8 pt-10 pb-0 md:grid-cols-[auto_auto] md:items-end md:justify-between md:pt-14"
  >
    <div class="flex flex-col items-center gap-6 pb-10 md:pb-14">
      <img
        src="/assets/images/Selo@2x-1024x791.png"
        alt="Cãocurso Condor"
        class="w-[min(70vw,320px)] max-w-full md:w-[min(35vw,420px)]"
        width="1024"
        height="791"
        loading="lazy"
      />
      <img
        src="/assets/images/Txt@2x-1.png"
        alt="Seu pet é a estrela da nossa passarela."
        class="w-full max-w-[546px]"
        width="934"
        height="198"
        loading="lazy"
      />
    </div>

    <div class="emerge flex self-end justify-center md:justify-end">
      <img
        src="/assets/images/Pet-2.png"
        alt="Cachorro de óculos escuros e jaqueta de couro"
        class="w-[min(78vw,384px)] max-w-full md:w-[min(40vw,588px)]"
        width="956"
        height="966"
        loading="lazy"
      />
    </div>
  </div>
</section>
