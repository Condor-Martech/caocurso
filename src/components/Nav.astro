---
import { navLinks } from '../data/site';

/**
 * Navegación.
 *
 * Desktop (md+): los 5 enlaces alineados a la derecha sobre el naranja, como
 * en el original.
 *
 * Móvil: barra fija con el logo Condor siempre visible + botón hamburguesa que
 * abre un sidebar lateral con el sello Mês Pet arriba. El original de WordPress
 * usaba el menú desplegable de Elementor; aquí es un drawer accesible.
 */
---

<header
  class="sticky top-0 z-40 w-full bg-[var(--c-orange)] md:static md:bg-transparent"
>
  <div class="container-lp flex items-center justify-between py-4 md:justify-end md:py-6">
    <!-- Logo: sólo en móvil; en desktop ya está el sello grande del hero -->
    <a href="#conteudo" class="md:hidden" aria-label="Início — Mês Pet Condor">
      <img
        src="/assets/images/Logo-Grande.png"
        alt="Condor"
        class="h-9 w-auto"
        width="200"
        height="60"
      />
    </a>

    <!-- Enlaces en desktop -->
    <nav class="hidden md:block" aria-label="Principal">
      <ul class="flex flex-wrap items-center justify-end gap-x-7 gap-y-2 md:gap-x-10">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link border-b-2 border-transparent pb-1 text-base font-semibold text-white hover:border-white md:text-lg"
                {...('external' in link && link.external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Hamburguesa -->
    <button
      type="button"
      id="menu-abrir"
      class="flex h-12 w-12 items-center justify-center rounded-lg text-white md:hidden"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-lateral"
    >
      <svg
        width="30"
        height="30"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>
</header>

<!-- Backdrop -->
<div
  id="menu-fondo"
  class="fixed inset-0 z-40 hidden bg-black/60 backdrop-blur-[2px] md:hidden"
></div>

<!-- Sidebar -->
<aside
  id="menu-lateral"
  class="fixed top-0 right-0 z-50 flex h-full w-[82%] max-w-[320px] translate-x-full flex-col bg-[var(--c-blue)] shadow-2xl transition-transform duration-300 ease-out md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  aria-hidden="true"
>
  <div class="flex items-start justify-between gap-4 px-5 pt-5">
    <img
      src="/assets/images/Selo.png"
      alt="Mês Pet Condor"
      class="w-28"
      width="685"
      height="863"
    />
    <button
      type="button"
      id="menu-cerrar"
      class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-white"
      aria-label="Fechar menu"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <nav class="mt-4 flex-1 overflow-y-auto px-5 pb-8" aria-label="Principal">
    <ul class="flex flex-col">
      {
        navLinks.map((link) => (
          <li class="border-b border-white/15">
            <a
              href={link.href}
              data-menu-link
              class="block py-4 text-lg font-semibold text-white"
              {...('external' in link && link.external
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      type="button"
      data-abrir-inscricao
      class="btn-lp mt-8 w-full rounded-xl bg-white px-6 py-4 text-base font-bold text-[var(--c-blue)]"
    >
      Inscreva-se
    </button>
  </nav>
</aside>

<script>
  const abrir = document.getElementById('menu-abrir');
  const cerrar = document.getElementById('menu-cerrar');
  const panel = document.getElementById('menu-lateral');
  const fondo = document.getElementById('menu-fondo');

  if (abrir && cerrar && panel && fondo) {
    const enlaces = panel.querySelectorAll<HTMLElement>('[data-menu-link], button');

    const mostrar = () => {
      fondo.classList.remove('hidden');
      panel.classList.remove('translate-x-full');
      panel.setAttribute('aria-hidden', 'false');
      abrir.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      enlaces[0]?.focus();
    };

    const ocultar = () => {
      fondo.classList.add('hidden');
      panel.classList.add('translate-x-full');
      panel.setAttribute('aria-hidden', 'true');
      abrir.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      abrir.focus();
    };

    abrir.addEventListener('click', mostrar);
    cerrar.addEventListener('click', ocultar);
    fondo.addEventListener('click', ocultar);

    // Al navegar a una ancla el menú debe cerrarse solo
    panel.querySelectorAll('[data-menu-link]').forEach((a) => {
      a.addEventListener('click', ocultar);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && abrir.getAttribute('aria-expanded') === 'true') {
        ocultar();
      }
    });

    // Si se pasa a desktop con el menú abierto, restaurar el scroll
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches && abrir.getAttribute('aria-expanded') === 'true') ocultar();
    });
  }
</script>
