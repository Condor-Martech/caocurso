---
import { caocurso, SITE } from '../data/site';

/**
 * Bloque «29 de agosto» — cabecera del evento Cãocurso 2026.
 *
 * El componente conserva el nombre Evento30Agosto por herencia de 2025 (aquella
 * edición cayó en día 30); lo que cambia es el contenido, no el archivo.
 *
 * Maqueta medida sobre `docs/Desktop - CãoCurso.png` (1366 px), franja
 * y≈3951–4305:
 *   · fondo lavanda #C38ADB (brand-purple), NO el #9E6BC2 que había hardcodeado;
 *   · bloque de 803 px centrado: dos columnas de ~351 px con 100 px de calle;
 *   · regla blanca fina bajo «29 de agosto» (sólo la columna izquierda) y otra
 *     de ancho completo cerrando el bloque por abajo;
 *   · la columna derecha va CENTRADA bajo el botón, no alineada a la derecha;
 *   · el botón «EM BREVE» es un rectángulo redondeado (352×88, radio 16), no
 *     una píldora, y la del regulamento sí es píldora de contorno fino.
 * Se eliminó la caja `bg-white/10 backdrop-blur` que envolvía el período de
 * inscripción: no existe en la referencia.
 */

/* `caocurso.horario` viene entero ('das 14h às 18h') porque en otros sitios se
   usa como frase única. Aquí la referencia pinta «das» en azul y la hora en
   blanco, así que se parte por el primer espacio. (La versión anterior escribía
   «das» a mano DELANTE de {caocurso.horario} y salía «das das 14h às 18h».) */
const [horarioPrefixo = '', ...horarioResto] = caocurso.horario.split(' ');
const horarioValor = horarioResto.join(' ');

/* El PDF del regulamento 2026 todavía no existe (SITE.regulamentoPdf === null).
   Mientras el flag esté en false el botón se pinta igual pero deshabilitado: un
   <a href={null}> sería un enlace roto. Cuando llegue el PDF basta con poner su
   ruta y `regulamentoDisponivel: true` en src/data/site.ts y esta misma rama
   vuelve a emitir el <a>.
   Los tipos se ensanchan a propósito: SITE es `as const`, así que sin las
   anotaciones TypeScript daría la rama del enlace por muerta. */
const regulamentoUrl: string | null = SITE.regulamentoPdf;
const temRegulamento: boolean = SITE.regulamentoDisponivel && regulamentoUrl !== null;

/* Mismo aspecto en las dos ramas: píldora de contorno fino azul sobre lavanda. */
const pilulaRegulamento =
  'mt-4 inline-block rounded-full border-2 border-brand-blue bg-transparent px-6 py-2.5 text-base leading-none text-brand-blue sm:text-lg';
---

<section class="bg-brand-purple pt-14 md:pt-20 lg:pt-26">
  <div class="container-lp">
    <div class="mx-auto max-w-201">
      <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-2 md:gap-x-25">
        <!-- Columna izquierda: fecha, local y horario -->
        <div class="text-center md:text-left">
          {/* md:whitespace-nowrap: a 60 px «29 de agosto» mide ~394 px y la
              columna sólo tiene ~352, así que en el mockup el título se mete en
              la calle de 100 px en vez de partirse en dos líneas. */}
          <h2
            class="text-[2.5rem] leading-none font-black text-brand-blue sm:text-5xl md:whitespace-nowrap lg:text-[3.75rem]"
          >
            {caocurso.data}
          </h2>

          <hr class="regla-branca mt-3 w-full" />

          <p
            class="mt-8 text-xl leading-tight font-bold text-brand-blue sm:text-2xl lg:mt-11 lg:text-[1.75rem]"
          >
            Local: {caocurso.local}
          </p>
          <p
            class="mt-1 text-[2.25rem] leading-none font-black text-brand-blue sm:text-[2.75rem] lg:text-[3.25rem]"
          >
            {horarioPrefixo} <span class="text-brand-white">{horarioValor}</span>
          </p>
        </div>

        <!-- Columna derecha: estado, período de inscripción y regulamento -->
        <div class="flex flex-col items-center text-center">
          {/*
            Insignia de estado, no un control: hasta que se abran las
            inscripciones no hay nada que pulsar, así que va como <p> y no como
            <button>. El texto se escribe en caja mixta y se pone en versales por
            CSS para que los lectores de pantalla no deletreen «E-M B-R-E-V-E».
          */}
          <p
            class="w-full rounded-2xl bg-brand-blue px-6 py-5 text-[2rem] leading-none font-black tracking-wide text-brand-white uppercase sm:text-[2.5rem] lg:text-[3rem]"
          >
            Em breve
          </p>

          <p class="mt-7 text-lg leading-tight text-brand-blue lg:text-xl">
            {caocurso.inscricaoRotulo}<br />{caocurso.inscricaoPeriodo}
          </p>

          {
            temRegulamento ? (
              <a
                href={regulamentoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class={`${pilulaRegulamento} transition-colors hover:bg-brand-blue hover:text-brand-white`}
              >
                Confira o regulamento
              </a>
            ) : (
              <button
                type="button"
                disabled
                aria-disabled="true"
                title="O regulamento de 2026 estará disponível em breve."
                class={`${pilulaRegulamento} cursor-not-allowed`}
              >
                Confira o regulamento
                <span class="sr-only"> — disponível em breve</span>
              </button>
            )
          }
        </div>
      </div>

      <!-- Regla que cierra el bloque, de ancho completo -->
      <hr class="regla-branca mt-7 w-full" />
    </div>
  </div>
</section>
