---
import { caocurso, SITE } from '../data/site';

/**
 * 30 AGOSTO — detalles del Cãocurso a la izquierda, botón píldora a la derecha.
 *
 * El original muestra "Encerrado" porque las inscripciones ya habían cerrado.
 * Aquí el botón dice "Inscreva-se" y abre el modal de inscripción: es la única
 * desviación deliberada respecto al original, porque el formulario tiene que
 * poder abrirse. Ver docs/GROUND_TRUTH.md §6.
 */
---

<section class="bg-[var(--c-orange)] py-12 md:py-16">
  <div class="container-lp">
    <div class="mx-auto grid max-w-4xl grid-cols-1 items-center gap-8 md:grid-cols-2">
      <!-- Detalles -->
      <div class="text-center md:text-left">
        <h2 class="text-2xl font-bold text-[var(--c-blue)] sm:text-3xl">
          {caocurso.data}
        </h2>
        <hr class="regla-branca mx-auto mt-3 mb-4 w-48 md:mx-0" />

        <p class="text-base font-bold text-[var(--c-blue)] sm:text-lg">
          Local: {caocurso.local}
        </p>
        <p class="text-lg font-bold sm:text-xl">
          <span class="text-[var(--c-blue)]">das </span>
          <span class="text-white">{caocurso.horario}</span>
        </p>
        <p class="mt-3 text-sm font-bold text-[var(--c-blue)] sm:text-base">
          {caocurso.inscricao}
        </p>

        <a
          href={SITE.regulamentoPdf}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-lp mt-4 inline-block rounded-full bg-[var(--c-blue)] px-5 py-2 text-xs font-semibold text-white"
        >
          Confira o regulamento
        </a>
      </div>

      <!-- CTA: abre el modal de inscripción -->
      <div class="flex justify-center md:justify-end">
        <button
          type="button"
          data-abrir-inscricao
          class="btn-lp w-full max-w-xs rounded-2xl bg-white px-10 py-5 text-lg font-bold text-[var(--c-blue)] shadow-lg"
        >
          Inscreva-se
        </button>
      </div>
    </div>

    <hr class="regla-branca mx-auto mt-12 max-w-4xl" />
  </div>
</section>
