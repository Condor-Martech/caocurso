---
/**
 * Insignia de red social del footer.
 *
 * OJO: este componente NO devuelve sólo el glifo, devuelve la insignia COMPLETA
 * —fondo redondo de marca + glifo—, porque en 2026 los iconos van a color
 * (Facebook azul, Instagram con su degradado, TikTok negro, YouTube rojo,
 * LinkedIn azul, Threads blanco) y no monocromos sobre un círculo blanco, como
 * estaban. Ver el recorte de referencia y=7000-8000: `docs/Desktop - CãoCurso.png`.
 *
 * ── Sobre los HEX ────────────────────────────────────────────────────────────
 * La paleta de la campaña es cerrada y prohíbe cualquier otro HEX, pero los
 * colores de abajo NO son de la campaña: son las marcas registradas de terceros
 * y no se pueden sustituir por tokens (un Facebook en #2F8FE5 deja de ser
 * Facebook). Están confinados a este archivo a propósito; ningún otro
 * componente debe copiarlos. Todos se muestrearon sobre la referencia.
 *
 * ── Geometría ────────────────────────────────────────────────────────────────
 * Lienzo de 40×40 = el diámetro de la insignia. Cada glifo va en un <svg>
 * anidado con su propio viewBox, y su caja (x/y/width/height) está calculada
 * para que la tinta caiga donde cae en la referencia: se midió el bounding box
 * de cada glifo en el mockup (insignia de 36 px) y se llevó a estas unidades.
 * Por eso los números no son redondos.
 */

interface Props {
  /** Clave de `socialLinks[].icon` en src/data/site.ts */
  name: string;
  /** Lado de la insignia en px. 36 = medida del mockup. */
  size?: number;
}

const { name, size = 36 } = Astro.props;

/* Fondo de la insignia. Instagram no está aquí: es un degradado y un cuadrado
   redondeado, no un círculo plano, así que se pinta aparte. */
const FUNDO: Record<string, string> = {
  facebook: '#1778F2',
  tiktok: '#000000',
  youtube: '#FF0000',
  linkedin: '#007EBB',
  threads: '#FFFFFF',
};

const REDES = ['facebook', 'instagram', 'tiktok', 'youtube', 'linkedin', 'threads'];
const conhecida = REDES.includes(name);

/* Antes había un `paths[name] ?? paths.facebook`: una red sin glifo se pintaba
   en silencio como Facebook, y así es como Threads salía con la "f" azul. Ahora
   se avisa por consola y se pinta un aro vacío, que canta en cuanto se mira. */
if (!conhecida) {
  console.warn(
    `[IconeSocial] "${name}" não tem glifo. Redes disponíveis: ${REDES.join(', ')}.`
  );
}

/* El degradado necesita un id único: si la insignia se repitiera en la página,
   dos <linearGradient id="ig"> harían que el segundo no se aplicara. */
const gradId = `ig-grad-${Math.random().toString(36).slice(2, 9)}`;

/* El glifo del "note" de TikTok se dibuja tres veces: cian desplazado a la
   izquierda, rojo a la derecha y blanco encima, que es como está construido el
   logotipo real. Los desplazamientos van en unidades del viewBox de 24. */
const TIKTOK =
  'M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-4.65 1.56 2.59 2.59 0 0 1 2.6-4.02V9.8a5.68 5.68 0 1 0 4.86 5.62V9.01a7.35 7.35 0 0 0 4.29 1.37V7.3a4.29 4.29 0 0 1-2.95-1.48Z';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 40 40"
  aria-hidden="true"
  focusable="false"
>
  {/* ---------- Fondo ---------- */}
  {
    name === 'instagram' && (
      <Fragment>
        <defs>
          {/* Degradado oficial de Instagram: del amarillo de la esquina inferior
              izquierda al azul-violeta de la superior derecha. */}
          <linearGradient id={gradId} x1="0" y1="1" x2="1" y2="0">
            <stop offset="0" stop-color="#FEDA75" />
            <stop offset="0.25" stop-color="#FA7E1E" />
            <stop offset="0.5" stop-color="#D62976" />
            <stop offset="0.75" stop-color="#962FBF" />
            <stop offset="1" stop-color="#4F5BD5" />
          </linearGradient>
        </defs>
        {/* Cuadrado redondeado, no círculo: es la forma que tiene en el mockup
            (es el icono de app de Instagram, que nunca es circular). */}
        <rect x="0" y="0" width="40" height="40" rx="10.5" fill={`url(#${gradId})`} />
      </Fragment>
    )
  }

  {FUNDO[name] && <circle cx="20" cy="20" r="20" fill={FUNDO[name]} />}

  {
    !conhecida && (
      <circle cx="20" cy="20" r="18.5" fill="none" stroke="#FFFFFF" stroke-width="3" />
    )
  }

  {/* ---------- Glifos ---------- */}
  {
    name === 'facebook' && (
      <svg x="9.95" y="7.25" width="20.1" height="32.1" viewBox="0 0 320 512">
        <path
          fill="#FFFFFF"
          d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"
        />
      </svg>
    )
  }

  {
    /* La cámara va a trazo, no a relleno: el glifo macizo habitual sale
       demasiado grueso al lado del del mockup, que es de línea fina. */
    name === 'instagram' && (
      <Fragment>
        <g fill="none" stroke="#FFFFFF" stroke-width="2.8">
          <rect x="6.4" y="6.4" width="27.2" height="27.2" rx="8.6" />
          <circle cx="20" cy="20" r="6.6" />
        </g>
        <circle cx="28" cy="12.1" r="1.72" fill="#FFFFFF" />
      </Fragment>
    )
  }

  {
    name === 'tiktok' && (
      <svg x="0" y="-1.4" width="42.7" height="42.7" viewBox="0 0 24 24">
        <path fill="#25F4EE" transform="translate(-0.55 0.3)" d={TIKTOK} />
        <path fill="#FE2C55" transform="translate(0.55 -0.3)" d={TIKTOK} />
        <path fill="#FFFFFF" d={TIKTOK} />
      </svg>
    )
  }

  {
    /* El trazado es el rectángulo redondeado CON el triángulo calado: relleno de
       blanco, el rojo del círculo asoma por el hueco y sale el play de YouTube. */
    name === 'youtube' && (
      <svg x="5.95" y="5.95" width="28.1" height="28.1" viewBox="0 0 24 24">
        <path
          fill="#FFFFFF"
          d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.08 0 12 0 12s0 3.92.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.92 24 12 24 12s0-3.92-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z"
        />
      </svg>
    )
  }

  {
    name === 'linkedin' && (
      <svg x="6.8" y="6.2" width="26.4" height="30.2" viewBox="0 0 448 512">
        <path
          fill="#FFFFFF"
          d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"
        />
      </svg>
    )
  }

  {
    /* Threads sustituye a X en 2026 (ver socialLinks en src/data/site.ts).
       Trazado oficial de Meta, viewBox de 192. */
    name === 'threads' && (
      <svg x="7.2" y="8.8" width="25.6" height="25.6" viewBox="0 0 192 192">
        <path
          fill="#000000"
          d="M141.537 88.9883C140.71 88.5919 139.87 88.2104 139.019 87.8451C137.537 60.5382 122.616 44.905 97.5619 44.745C97.4484 44.7443 97.3355 44.7443 97.222 44.7443C82.2364 44.7443 69.7731 51.1409 62.102 62.7807L75.881 72.2328C81.6116 63.5383 90.6052 61.6848 97.2286 61.6848C97.3051 61.6848 97.3819 61.6848 97.4576 61.6855C105.707 61.7381 111.932 64.1366 115.961 68.814C118.893 72.2193 120.854 76.925 121.825 82.8638C114.511 81.6207 106.601 81.2385 98.145 81.7233C74.3247 83.0954 59.0111 96.9879 60.0396 116.292C60.5615 126.084 65.4397 134.508 73.775 140.011C80.8224 144.663 89.899 146.938 99.3323 146.423C111.79 145.74 121.563 140.987 128.381 132.296C133.559 125.696 136.834 117.143 138.28 106.366C144.217 109.949 148.617 114.664 151.047 120.332C155.179 129.967 155.42 145.8 142.501 158.708C131.182 170.016 117.576 174.908 97.0135 175.059C74.2042 174.89 56.9538 167.575 45.7381 153.317C35.2355 139.966 29.8077 120.682 29.6052 96C29.8077 71.3178 35.2355 52.0336 45.7381 38.6827C56.9538 24.4249 74.2039 17.11 97.0132 16.9405C119.988 17.1113 137.539 24.4614 149.184 38.788C154.894 45.8136 159.199 54.6488 162.037 64.9503L178.184 60.6422C174.744 47.9622 169.331 37.0357 161.965 27.974C147.036 9.60668 125.202 0.195148 97.0695 0H96.9569C68.8816 0.19447 47.2921 9.6418 32.7883 28.0793C19.8819 44.4864 13.2244 67.3157 13.0007 95.9325L13 96L13.0007 96.0675C13.2244 124.684 19.8819 147.514 32.7883 163.921C47.2921 182.358 68.8816 191.806 96.9569 192H97.0695C122.03 191.827 139.624 185.292 154.118 170.811C173.081 151.866 172.51 128.119 166.26 113.541C161.776 103.087 153.227 94.5962 141.537 88.9883ZM98.4405 129.507C88.0005 130.095 77.1544 125.409 76.6196 115.372C76.2232 107.93 81.9158 99.626 99.0812 98.6368C101.047 98.5234 102.976 98.468 104.871 98.468C111.106 98.468 116.939 99.0737 122.242 100.233C120.264 124.935 108.662 128.946 98.4405 129.507Z"
        />
      </svg>
    )
  }
</svg>
